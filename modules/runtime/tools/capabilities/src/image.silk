//! `silk task image --program PROGRAM`: gives an embedding program the heap image the executable
//! gets from tools/build.py (docs/composable-runtime.md, step 7). The program writes its own
//! image (`PROGRAM --silk-write-heap-image PATH`, with no environment, from `/`), which it can
//! only do when it starts the runtime with `Options.ownsProcess` and passes that argument on; the
//! task then appends the image to the program, page-aligned, with the trailer heap_image.load
//! reads: offset, length, range count and magic, as four little-endian words. An image the
//! program had before is replaced. A start from it is a start of that program, with those
//! capabilities: the image holds the code addresses of the binary that wrote it.
import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u64
import silk.num.usize
import silk.system.child_process { ChildProcess, ProcessError, Exited, Signaled }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }

const PAGE: usize = 4096
// "SILKIMG1", little-endian (heap_image.MAGIC).
const MAGIC: u64 = 0x31474d494b4c4953

fn word(bytes: &[u8], at: usize) -> u64 {
  let mut value: u64 = 0
  let mut index: usize = 0
  while index < 8 { value = u64.bitOr(value, u64.shiftLeft(u8.toU64(bytes[at + index]), usize.toU64(index * 8))) index = index + 1 }
  return value
}
effect fn putWord(out: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut bytes: [u8; 8] = [0; 8]
  let mut index: usize = 0
  while index < 8 { bytes[index] = u64.wrappingToU8(u64.shiftRight(value, usize.toU64(index * 8))) index = index + 1 }
  run out.append(&bytes)
}
// The length of `program` without an image appended earlier (and its padding).
fn withoutImage(program: &[u8]) -> usize {
  if program.length < 32 { return program.length }
  let end = program.length - 32
  if word(program, end + 24) != MAGIC { return program.length }
  let offset = u64.toUsize(word(program, end))
  if offset > end { return program.length }
  // The padding before the image is zeros up to its page: the program ends before them.
  let mut cut = offset
  while cut > 0 && program[cut - 1] == 0 && cut + PAGE > offset { cut = cut - 1 }
  return cut
}

pub effect fn image(binary: &[u8]) -> ()
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let package = run Task.root()
  let program = if binary.length > 0 && binary[0] == 47 { run Path.fromBytes(binary) } else { run Path.resolveBytes(&package, binary) }
  let mut imageName = run Bytes.copy(Path.rawBytes(&program))
  run imageName.append(b".heap-image")
  let imagePath = run Path.fromBytes(imageName.asSlice())
  let directory = run Path.root()
  let mut request = run ChildProcess.requestWithin(&program, &directory)
  run ChildProcess.addArgumentBytes(&mut request, b"--silk-write-heap-image")
  run ChildProcess.addArgumentBytes(&mut request, imageName.asSlice())
  let outcome = run ChildProcess.submit(&request)
  let written = match move outcome.value {
    Exited { code, .. } => code == 0
    Signaled { .. } => false
  }
  if !written { run Task.abort("the program did not write its heap image: does it start the runtime with Options.ownsProcess and pass --silk-write-heap-image on?") }
  let original = run FileSystem.readFile(&program)
  let image = run FileSystem.readFile(&imagePath)
  let kept = withoutImage(original.asSlice())
  let mut out = Bytes.make()
  run out.append(Slice.view<u8>(original.asSlice(), 0, kept))
  let zero: [u8; 1] = [0]
  while out.length() % PAGE != 0 { run out.append(&zero) }
  let offset = out.length()
  run out.append(image.asSlice())
  run putWord(&mut out, usize.toU64(offset))
  run putWord(&mut out, usize.toU64(image.length()))
  run putWord(&mut out, 0)
  run putWord(&mut out, MAGIC)
  run FileSystem.writeFile(&program, out.asSlice())
  run FileSystem.removeFile(&imagePath)
}
