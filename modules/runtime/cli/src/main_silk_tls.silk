//! src/main_silk.silk with SilkTls (./silktls, over silk.tls) for OpenSSL's TLS too: compression,
//! HTTP/1, HTTP/2, crypto and TLS all in Silk. SilkTls needs silk.tls's deferred
//! client verification (`Client.deferVerification`), which the pinned toolchain does not have yet,
//! so this variant builds with a standard library that has it (docs/composable-runtime.md, step 8):
//! `silk task tls-stdlib` in tools/capabilities writes it, then
//! silk build src/main_silk_tls.silk --stdlib ../build/stdlib-tls.
import silk.system.host_input { HostInput }
import silkcompress.silk_compression { SilkCompression }
import silkhttp.silk_http { SilkHttp }
import silkhttp2.silk_http2 { SilkHttp2 }
import silkcrypto.silk_crypto { SilkCrypto }
import silktls.silk_tls { SilkTls }
import main as executable

pub effect fn main() -> i32 ? &mut HostInput { return run executable.mainWith(SilkCompression.make(), SilkHttp2.make(), SilkCrypto.make(), SilkHttp.make(), SilkTls.make()) }
