//! The executable with the Silk implementations of its library capabilities in place of the C
//! libraries: SilkCompression (./silkcompress, over silk.compress) for zlib, brotli and zstd,
//! SilkHttp2 (./silkhttp2) for nghttp2, SilkCrypto (./silkcrypto, over silk.crypto) and SilkTls
//! (./silktls, over silk.tls) for OpenSSL, and SilkHttp (./silkhttp) for llhttp. Step 8 of
//! docs/composable-runtime.md; the differentials (tests/compression-differential.mjs,
//! tests/crypto-differential.mjs, tests/http-parser-differential.mjs) and Node's HTTP/2, TLS and
//! HTTPS tests measure it. SilkTls needs silk.tls's deferred client verification
//! (`Client.deferVerification`), which the pinned toolchain does not have yet, so this executable
//! builds with a standard library that has it: `silk task tls-stdlib` in tools/capabilities writes
//! it, then silk build src/main_silk.silk --stdlib ../build/stdlib-tls.
import silk.system.host_input { HostInput }
import silkcompress.silk_compression { SilkCompression }
import silkhttp.silk_http { SilkHttp }
import silkhttp2.silk_http2 { SilkHttp2 }
import silkcrypto.silk_crypto { SilkCrypto }
import silktls.silk_tls { SilkTls }
import main as executable

pub effect fn main() -> i32 ? &mut HostInput { return run executable.mainWith(SilkCompression.make(), SilkHttp2.make(), SilkCrypto.make(), SilkHttp.make(), SilkTls.make()) }
