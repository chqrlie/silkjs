//! The libuv functions a Node-API addon can call on the loop that `napi_get_uv_event_loop` hands
//! it. The runtime has no libuv: these are C symbols with libuv's names and calling conventions
//! over the runtime's own loop (`ext.uv_loop`), for the addons that keep a timer or an async
//! handle on the loop or start a thread. It is a subset, not libuv's API: timers, async handles,
//! close, ref and unref, the handle data word, the clock, and threads.
//!
//! An addon allocates `uv_timer_t` or `uv_async_t` itself, with libuv's sizes, and reads the public
//! head of the record: `data`, `loop`, `type`. This module keeps that head as libuv lays it out and
//! puts its own words where libuv keeps private ones (the close callback, then the handle queue):
//! a pointer to the loop's real handle, which this module allocates, and the addon's callback.
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import ext.uv_loop as uvl

unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
@threadCallbacks("start")
unsafe extern "C" fn pthread_create(thread: *mut usize, attributes: ?*const u8, start: extern "C" fn(?*mut u8) -> ?*mut u8, argument: ?*mut u8) -> i32
unsafe extern "C" fn pthread_join(thread: usize, result: ?*mut ?*mut u8) -> i32

type Callback = extern "C" fn(*mut u8) -> ()
// What an addon passes: libuv accepts a null close callback.
type Given = ?extern "C" fn(*mut u8) -> ()
type ThreadEntry = extern "C" fn(?*mut u8) -> ()
// The head of libuv's uv_handle_t: data, loop, type, close_cb, and two words of its handle queue.
extern "C" struct Head { data: ?*mut u8, loop: *mut u8, kind: i32, padding: i32, closed: Given, inner: *mut u8, fired: Callback }
struct Start { entry: ThreadEntry, argument: ?*mut u8 }

unsafe fn nn(pointer: ?*mut u8) -> *mut u8 { return unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(pointer) }
unsafe fn head(handle: *mut u8) -> *mut Head { return unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Head>(handle) }
unsafe fn inner(handle: *mut u8) -> *mut u8 {
  let anchor = () let h = unsafe Pointer.borrow<(), Head>(&anchor, unsafe head(handle))
  return h.inner
}
export "C" fn silkUvAddonNothing(handle: *mut u8) -> () {}
// The loop's callback for the real handle: the addon's callback gets the addon's record.
export "C" fn silkUvAddonFired(real: *mut u8) -> () {
  let outer = unsafe nn(unsafe uvl.uv_handle_get_data(real))
  let anchor = () let h = unsafe Pointer.borrow<(), Head>(&anchor, unsafe head(outer))
  let callback = h.fired drop h
  unsafe callback(outer)
}
export "C" fn silkUvAddonClosed(real: *mut u8) -> () {
  let outer = unsafe nn(unsafe uvl.uv_handle_get_data(real))
  let anchor = () let h = unsafe Pointer.borrow<(), Head>(&anchor, unsafe head(outer))
  let callback = h.closed drop h
  unsafe free(real)
  if !Intrinsic.pointerIsNull<Given>(callback) { let present = unsafe Intrinsic.pointerRequalify<Given, Callback>(callback) unsafe present(outer) }
}
// Allocates the loop's handle for the addon's record and fills the record's head. The addon's
// `data` word is left as it is, as libuv leaves it.
unsafe fn adopt(loop: *mut u8, handle: *mut u8, kind: i32) -> ?*mut u8 {
  let real = unsafe calloc(1, unsafe uvl.uv_handle_size(kind))
  if Pointer.isNull<u8>(real) { return real }
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Head>(&mut anchor, unsafe head(handle))
  h.loop = loop h.kind = kind h.closed = Intrinsic.pointerNullFunction<Given>() h.inner = unsafe nn(real) h.fired = silkUvAddonNothing
  return real
}
pub export "C" fn uv_timer_init(loop: *mut u8, handle: *mut u8) -> i32 {
  let real = unsafe adopt(loop, handle, uvl.UV_TIMER)
  if Pointer.isNull<u8>(real) { return -12 }
  let status = unsafe uvl.uv_timer_init(loop, unsafe nn(real))
  unsafe uvl.uv_handle_set_data(unsafe nn(real), handle)
  return status
}
@deferredCallbacks("callback")
pub unsafe export "C" fn uv_timer_start(handle: *mut u8, callback: Given, timeout: u64, repeat: u64) -> i32 {
  if Intrinsic.pointerIsNull<Given>(callback) { return -22 }
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Head>(&mut anchor, unsafe head(handle))
  h.fired = unsafe Intrinsic.pointerRequalify<Given, Callback>(callback) let real = h.inner drop h
  return unsafe uvl.uv_timer_start(real, silkUvAddonFired, timeout, repeat)
}
pub export "C" fn uv_timer_stop(handle: *mut u8) -> i32 { return unsafe uvl.uv_timer_stop(unsafe inner(handle)) }
@deferredCallbacks("callback")
pub unsafe export "C" fn uv_async_init(loop: *mut u8, handle: *mut u8, callback: Given) -> i32 {
  let real = unsafe adopt(loop, handle, uvl.UV_ASYNC)
  if Pointer.isNull<u8>(real) { return -12 }
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Head>(&mut anchor, unsafe head(handle))
  if !Intrinsic.pointerIsNull<Given>(callback) { h.fired = unsafe Intrinsic.pointerRequalify<Given, Callback>(callback) }
  drop h
  let status = unsafe uvl.uv_async_init(loop, unsafe nn(real), silkUvAddonFired)
  unsafe uvl.uv_handle_set_data(unsafe nn(real), handle)
  return status
}
pub export "C" fn uv_async_send(handle: *mut u8) -> i32 { return unsafe uvl.uv_async_send(unsafe inner(handle)) }
@deferredCallbacks("callback")
pub unsafe export "C" fn uv_close(handle: *mut u8, callback: Given) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Head>(&mut anchor, unsafe head(handle))
  h.closed = callback let real = h.inner drop h
  unsafe uvl.uv_close(real, silkUvAddonClosed)
}
pub export "C" fn uv_ref(handle: *mut u8) -> () { unsafe uvl.uv_ref(unsafe inner(handle)) }
pub export "C" fn uv_unref(handle: *mut u8) -> () { unsafe uvl.uv_unref(unsafe inner(handle)) }
pub export "C" fn uv_has_ref(handle: *mut u8) -> i32 { return unsafe uvl.uv_has_ref(unsafe inner(handle)) }
pub export "C" fn uv_is_active(handle: *mut u8) -> i32 { return unsafe uvl.uv_is_active(unsafe inner(handle)) }
pub export "C" fn uv_is_closing(handle: *mut u8) -> i32 { return unsafe uvl.uv_is_closing(unsafe inner(handle)) }
pub export "C" fn uv_handle_get_data(handle: *mut u8) -> ?*mut u8 {
  let anchor = () let h = unsafe Pointer.borrow<(), Head>(&anchor, unsafe head(handle))
  return h.data
}
pub export "C" fn uv_handle_set_data(handle: *mut u8, data: ?*mut u8) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Head>(&mut anchor, unsafe head(handle))
  h.data = data
}
pub export "C" fn uv_now(loop: *mut u8) -> u64 { return unsafe uvl.uv_now(loop) }
pub export "C" fn uv_hrtime() -> u64 { return unsafe uvl.hrtime() }
export "C" fn silkUvAddonThread(raw: ?*mut u8) -> ?*mut u8 {
  let start = unsafe Pointer.take<Start>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Start>(unsafe nn(raw)))
  unsafe free(raw)
  let entry = start.entry
  unsafe entry(start.argument)
  return Pointer.null<u8>()
}
/// libuv's uv_thread_create: `entry(argument)` on a new joinable thread. 0, or a negative errno.
@threadCallbacks("entry")
pub unsafe export "C" fn uv_thread_create(thread: *mut usize, entry: ThreadEntry, argument: ?*mut u8) -> i32 {
  let memory = unsafe calloc(1, Layout.of<Start>().bytes)
  if Pointer.isNull<u8>(memory) { return -12 }
  unsafe Pointer.put<Start>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Start>(unsafe nn(memory)), Start { entry: entry, argument: argument })
  let status = unsafe pthread_create(thread, Pointer.null<u8>(), silkUvAddonThread, memory)
  if status != 0 { unsafe free(memory) return -status }
  return 0
}
pub export "C" fn uv_thread_join(thread: *mut usize) -> i32 { return -(unsafe pthread_join(unsafe Pointer.read<usize>(thread), Pointer.null<?*mut u8>())) }


// Generated by tools/keep_exports.py; do not edit below.
/// Takes each C export as a value, so that Silk emits it (see tools/keep_exports.py).
pub fn keepExports() -> () {
  let _silkUvAddonNothing: extern "C" fn(*mut u8) -> () = silkUvAddonNothing
  let _silkUvAddonFired: extern "C" fn(*mut u8) -> () = silkUvAddonFired
  let _silkUvAddonClosed: extern "C" fn(*mut u8) -> () = silkUvAddonClosed
  let _uv_timer_init: extern "C" fn(*mut u8, *mut u8) -> i32 = uv_timer_init
  let _uv_timer_stop: extern "C" fn(*mut u8) -> i32 = uv_timer_stop
  let _uv_async_send: extern "C" fn(*mut u8) -> i32 = uv_async_send
  let _uv_ref: extern "C" fn(*mut u8) -> () = uv_ref
  let _uv_unref: extern "C" fn(*mut u8) -> () = uv_unref
  let _uv_has_ref: extern "C" fn(*mut u8) -> i32 = uv_has_ref
  let _uv_is_active: extern "C" fn(*mut u8) -> i32 = uv_is_active
  let _uv_is_closing: extern "C" fn(*mut u8) -> i32 = uv_is_closing
  let _uv_handle_get_data: extern "C" fn(*mut u8) -> ?*mut u8 = uv_handle_get_data
  let _uv_handle_set_data: extern "C" fn(*mut u8, ?*mut u8) -> () = uv_handle_set_data
  let _uv_now: extern "C" fn(*mut u8) -> u64 = uv_now
  let _uv_hrtime: extern "C" fn() -> u64 = uv_hrtime
  let _silkUvAddonThread: extern "C" fn(?*mut u8) -> ?*mut u8 = silkUvAddonThread
  let _uv_thread_join: extern "C" fn(*mut usize) -> i32 = uv_thread_join
}
