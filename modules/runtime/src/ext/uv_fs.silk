//! What is left of libuv's filesystem ABI: the stat layouts the `Files` operations fill (fs_ops
//! makes them itself, with no libuv request), and `uv_run`,
//! which the loop and the stat watchers still need (the loop plan, docs/composable-runtime.md).
pub extern "C" struct UvTimespec { pub tv_sec: isize, pub tv_nsec: isize }
pub extern "C" struct UvStat {
  pub st_dev: u64,
  pub st_mode: u64,
  pub st_nlink: u64,
  pub st_uid: u64,
  pub st_gid: u64,
  pub st_rdev: u64,
  pub st_ino: u64,
  pub st_size: u64,
  pub st_blksize: u64,
  pub st_blocks: u64,
  pub st_flags: u64,
  pub st_gen: u64,
  pub st_atim: UvTimespec, pub st_mtim: UvTimespec, pub st_ctim: UvTimespec, pub st_birthtim: UvTimespec
}
pub extern "C" struct UvStatfs { pub f_type: u64, pub f_bsize: u64, pub f_blocks: u64, pub f_bfree: u64, pub f_bavail: u64, pub f_files: u64, pub f_ffree: u64, pub f_frsize: u64, pub f_spare: [u64; 3] }
@invokesDeferredCallbacks
pub unsafe extern "C" fn uv_run(loop: *mut u8, mode: i32) -> i32
