    let mut buffer: [u64; 512] = [0; 512]
    let base = unsafe Intrinsic.pointerReinterpret<*mut u64, *mut u8>(Pointer.fromMutRef<u64>(&mut buffer[0]))
    while true {
      let anchor = () let l = unsafe Pointer.borrow<(), Loop>(&anchor, loop)
      let fd = l.notify drop l
      if fd < 0 { return }
      let size = unsafe read(fd, base, 4096)
      if size < 0 { if unsafe errno() == EINTR { continue } return }
      if size == 0 { return }
      let bytes = unsafe Pointer.assumeManyMut<u8>(base)
      let mut offset: usize = 0
      while offset + 16 <= isize.toUsize(size) {
        // struct inotify_event { int wd; uint32_t mask, cookie, len; char name[]; }
        let watch = u32.toI32(unsafe word(bytes, offset))
        let mask = unsafe word(bytes, offset + 4)
        let length = unsafe word(bytes, offset + 12)
        let name: *const u8 = unsafe Pointer.atMut<u8>(bytes, offset + 16)
        offset = offset + 16 + u32.toUsize(length)
        let mut events: i32 = 0
        if (mask & 6) != 0 { events = events | UV_CHANGE }
        if (mask & (6 ^ 4294967295)) != 0 { events = events | UV_RENAME }
        let mut second = () let l2 = unsafe Pointer.borrowMut<(), Loop>(&mut second, loop)
        l2.serial = l2.serial + 1 let serial = l2.serial drop l2
        while true {
          let found = unsafe nextWatcher(loop, watch, serial)
          if Pointer.isNull<Handle>(found) { break }
          let handle = unsafe nn(found)
          let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle)
          let callback = h.changed
          // A watch of one file gets no name from inotify: the file's own name stands in.
          let reported = if length != 0 { name } else { unsafe baseName(unsafe nn(h.path)) }
          drop h
          unsafe callback(unsafe bytesOf(handle), reported, events, 0)
        }
      }
    }
  }
}

// ---- File-system stat polls -------------------------------------------------------------------
static if Intrinsic.targetOperatingSystem() == "darwin" {
  extern "C" struct NativeStat {
    dev: i32, mode: u16, nlink: u16, ino: u64, uid: u32, gid: u32, rdev: i32,
    atime: TimeSpec, mtime: TimeSpec, ctime: TimeSpec, birthtime: TimeSpec,
    size: i64, blocks: i64, blksize: i32, flags: u32, gen: u32, spare: i32, reserved: [i64; 2]
  }
  @foreign(noCapture: .("path", "buffer"))
  unsafe extern "C" fn stat(path: *const u8, buffer: *mut NativeStat) -> i32
  fn time(value: TimeSpec) -> UvTimespec { return UvTimespec { tv_sec: i64.toIsize(value.seconds), tv_nsec: i64.toIsize(value.nanoseconds) } }
  unsafe fn statPath(path: *const u8, out: &mut UvStat) -> i32 {
    let zero = TimeSpec { seconds: 0, nanoseconds: 0 }
    let mut s = NativeStat { dev: 0, mode: 0, nlink: 0, ino: 0, uid: 0, gid: 0, rdev: 0, atime: zero, mtime: zero, ctime: zero, birthtime: zero, size: 0, blocks: 0, blksize: 0, flags: 0, gen: 0, spare: 0, reserved: [0; 2] }
    if unsafe stat(path, Pointer.fromMutRef<NativeStat>(&mut s)) != 0 { return -(unsafe errno()) }
    out.st_dev = i64.toU64(i32.toI64(s.dev)) out.st_mode = u16.toU64(s.mode) out.st_nlink = u16.toU64(s.nlink) out.st_uid = u32.toU64(s.uid) out.st_gid = u32.toU64(s.gid)
    out.st_rdev = i64.toU64(i32.toI64(s.rdev)) out.st_ino = s.ino out.st_size = i64.toU64(s.size) out.st_blksize = i64.toU64(i32.toI64(s.blksize)) out.st_blocks = i64.toU64(s.blocks)
    out.st_flags = u32.toU64(s.flags) out.st_gen = u32.toU64(s.gen)
    out.st_atim = time(s.atime) out.st_mtim = time(s.mtime) out.st_ctim = time(s.ctime) out.st_birthtim = time(s.birthtime)
    return 0
  }
} else {
  extern "C" struct StatxTime { seconds: i64, nanoseconds: u32, reserved: i32 }
  impl Copy for StatxTime {}
  extern "C" struct Statx {
    mask: u32, blksize: u32, attributes: u64, nlink: u32, uid: u32, gid: u32, mode: u16, pad: u16, ino: u64, size: u64, blocks: u64, attributesMask: u64,
    atime: StatxTime, btime: StatxTime, ctime: StatxTime, mtime: StatxTime,
    rdevMajor: u32, rdevMinor: u32, devMajor: u32, devMinor: u32, spare: [u64; 14]
  }
  @foreign(noCapture: .("path", "buffer"))
  unsafe extern "C" fn statx(directory: i32, path: *const u8, flags: i32, mask: u32, buffer: *mut Statx) -> i32
  fn time(value: StatxTime) -> UvTimespec { return UvTimespec { tv_sec: i64.toIsize(value.seconds), tv_nsec: u32.toIsize(value.nanoseconds) } }
  fn zeroStatxTime() -> StatxTime { return StatxTime { seconds: 0, nanoseconds: 0, reserved: 0 } }
  // glibc's makedev.
  fn device(major: u32, minor: u32) -> u64 {
    let high = u32.toU64(major) let low = u32.toU64(minor)
    return u64.shiftLeft(high & 4294963200, 32) | u64.shiftLeft(high & 4095, 8) | u64.shiftLeft(low & 4294967040, 12) | (low & 255)
  }
  // statx with STATX_BASIC_STATS | STATX_BTIME, mapped as libuv maps it.
  unsafe fn statPath(path: *const u8, out: &mut UvStat) -> i32 {
    let mut s = Statx { mask: 0, blksize: 0, attributes: 0, nlink: 0, uid: 0, gid: 0, mode: 0, pad: 0, ino: 0, size: 0, blocks: 0, attributesMask: 0, atime: zeroStatxTime(), btime: zeroStatxTime(), ctime: zeroStatxTime(), mtime: zeroStatxTime(), rdevMajor: 0, rdevMinor: 0, devMajor: 0, devMinor: 0, spare: [0; 14] }
    if unsafe statx(-100, path, 0, 4095, Pointer.fromMutRef<Statx>(&mut s)) != 0 { return -(unsafe errno()) }
    out.st_dev = device(s.devMajor, s.devMinor) out.st_mode = u16.toU64(s.mode) out.st_nlink = u32.toU64(s.nlink) out.st_uid = u32.toU64(s.uid) out.st_gid = u32.toU64(s.gid)
    out.st_rdev = device(s.rdevMajor, s.rdevMinor) out.st_ino = s.ino out.st_size = s.size out.st_blksize = u32.toU64(s.blksize) out.st_blocks = s.blocks
    out.st_flags = 0 out.st_gen = 0
    out.st_atim = time(s.atime) out.st_mtim = time(s.mtime) out.st_ctim = time(s.ctime) out.st_birthtim = time(s.btime)
    return 0
  }
}
fn sameTime(a: &UvTimespec, b: &UvTimespec) -> bool { return a.tv_sec == b.tv_sec && a.tv_nsec == b.tv_nsec }
// libuv's statbuf_eq: what makes fs.watchFile report a change.
fn sameStat(a: &UvStat, b: &UvStat) -> bool {
  return sameTime(&a.st_ctim, &b.st_ctim) && sameTime(&a.st_mtim, &b.st_mtim) && sameTime(&a.st_birthtim, &b.st_birthtim)
    && a.st_size == b.st_size && a.st_mode == b.st_mode && a.st_uid == b.st_uid && a.st_gid == b.st_gid
    && a.st_ino == b.st_ino && a.st_dev == b.st_dev && a.st_flags == b.st_flags && a.st_gen == b.st_gen
}
unsafe fn unlinkTimer(handle: *mut Handle) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  let mut second = () let l = unsafe Pointer.borrowMut<(), Loop>(&mut second, h.loop)
  if same(l.timers, handle) { l.timers = h.nextTimer }
  else {
    let mut cursor = l.timers
    while !Pointer.isNull<Handle>(cursor) {
      let mut third = () let c = unsafe Pointer.borrowMut<(), Handle>(&mut third, unsafe nn(cursor))
      if same(c.nextTimer, handle) { c.nextTimer = h.nextTimer break }
      cursor = c.nextTimer
    }
  }
  h.nextTimer = Pointer.null<Handle>()
}
pub unsafe fn uv_fs_poll_init(loopMemory: *mut u8, memory: *mut u8) -> i32 {
  let _handle = unsafe initialize(unsafe loopOf(loopMemory), memory, UV_FS_POLL)
  return 0
}
/// Stats `path` every `interval` milliseconds and calls `callback(handle, status, previous,
/// current)` when the result changes, as libuv's uv_fs_poll: the first result is only remembered,
/// and a failure is reported once until the status changes. The first stat is at the next run.
/// The stat runs on the loop's thread (libuv ran it on its thread pool).
pub unsafe fn uv_fs_poll_start(memory: *mut u8, callback: FsPollCallback, path: *const u8, interval: u32) -> i32 {
  let handle = unsafe handleOf(memory)
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if (h.flags & ACTIVE) != 0 { return 0 }
  let copy = unsafe copyText(path)
  if Pointer.isNull<u8>(copy) { return -12 }
  let mut second = () let l = unsafe Pointer.borrowMut<(), Loop>(&mut second, h.loop)
  h.path = copy h.statChanged = callback h.interval = if interval == 0 { 1 } else { u32.toU64(interval) }
  l.timerCount = l.timerCount + 1
  h.busy = 0 h.started = l.time h.due = l.time h.order = l.timerCount h.stat = zeroStat()
  h.nextTimer = l.timers l.timers = handle
  drop h drop l
  unsafe start(handle)
  return 0
}
pub unsafe fn uv_fs_poll_stop(memory: *mut u8) -> i32 {
  let handle = unsafe handleOf(memory)
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if (h.flags & ACTIVE) == 0 || h.kind != UV_FS_POLL { return 0 }
  drop h
  unsafe unlinkTimer(handle)
  let h2 = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  unsafe free(h2.path) h2.path = Pointer.null<u8>() drop h2
  unsafe stop(handle)
  return 0
}
unsafe fn pollTick(loop: *mut Loop, handle: *mut Handle) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  let second = () let l = unsafe Pointer.borrow<(), Loop>(&second, loop)
  h.started = l.time drop l
  let mut current = zeroStat() let previous = h.stat let zero = zeroStat()
  let status = unsafe statPath(unsafe nn(h.path), &mut current)
  let callback = h.statChanged let busy = h.busy
  if status != 0 {
    h.busy = status drop h
    if busy != status { unsafe callback(unsafe bytesOf(handle), status, Pointer.fromRef<UvStat>(&previous), Pointer.fromRef<UvStat>(&zero)) }
  } else {
    h.stat = current h.busy = 1 drop h
    if busy != 0 && (busy < 0 || !sameStat(&previous, &current)) { unsafe callback(unsafe bytesOf(handle), 0, Pointer.fromRef<UvStat>(&previous), Pointer.fromRef<UvStat>(&current)) }
  }
  let h2 = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if (h2.flags & ACTIVE) == 0 || (h2.flags & (CLOSING | CLOSED)) != 0 { return }
  unsafe updateTime(loop)
  let l2 = unsafe Pointer.borrow<(), Loop>(&second, loop)
  // The next stat keeps the rhythm of the interval, less the time this one took.
  h2.due = l2.time + (h2.interval - (l2.time - h2.started) % h2.interval)
}
/// A timer handle, for Node-API addons that use the loop (the runtime's own timers are not handles).
pub unsafe fn uv_timer_init(loopMemory: *mut u8, memory: *mut u8) -> i32 {
  let _handle = unsafe initialize(unsafe loopOf(loopMemory), memory, UV_TIMER)
  return 0
}
/// Calls `callback(handle)` after `timeout` milliseconds, and then every `repeat` if that is not 0.
pub unsafe fn uv_timer_start(memory: *mut u8, callback: AsyncCallback, timeout: u64, repeat: u64) -> i32 {
  let handle = unsafe handleOf(memory)
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  if (h.flags & (CLOSING | CLOSED)) != 0 { return -22 }
  let active = (h.flags & ACTIVE) != 0 drop h
  if active { let _ignored = unsafe uv_timer_stop(memory) }
  let h2 = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  let mut second = () let l = unsafe Pointer.borrowMut<(), Loop>(&mut second, h2.loop)
  l.timerCount = l.timerCount + 1
  h2.fired = callback h2.repeat = repeat h2.due = l.time + timeout h2.order = l.timerCount
  h2.nextTimer = l.timers l.timers = handle
  drop h2 drop l
  unsafe start(handle)
  return 0
}
pub unsafe fn uv_timer_stop(memory: *mut u8) -> i32 {
  let handle = unsafe handleOf(memory)
  let anchor = () let h = unsafe Pointer.borrow<(), Handle>(&anchor, handle)
  if (h.flags & ACTIVE) == 0 || h.kind != UV_TIMER { return 0 }
  drop h
  unsafe unlinkTimer(handle)
  unsafe stop(handle)
  return 0
}
unsafe fn timerTick(loop: *mut Loop, handle: *mut Handle) -> () {
  let mut anchor = () let h = unsafe Pointer.borrowMut<(), Handle>(&mut anchor, handle)
  let callback = h.fired let repeat = h.repeat drop h
  // As libuv: the timer stops, a repeating one starts again, and then the callback runs.
  let _ignored = unsafe uv_timer_stop(unsafe bytesOf(handle))
  if repeat != 0 { let _again = unsafe uv_timer_start(unsafe bytesOf(handle), callback, repeat, repeat) }
  unsafe callback(unsafe bytesOf(handle))
}
// Runs the timers that are due, the earliest first and then in the order they started. A callback
// may start or stop timers, so each step searches the list afresh; `serial` marks the ones done.
unsafe fn runTimers(loop: *mut Loop) -> () {
  let mut anchor = () let l = unsafe Pointer.borrowMut<(), Loop>(&mut anchor, loop)
  if Pointer.isNull<Handle>(l.timers) { return }
  l.serial = l.serial + 1 let serial = l.serial let now = l.time drop l
  while true {
    let l2 = unsafe Pointer.borrow<(), Loop>(&anchor, loop)
    let mut cursor = l2.timers let mut due: ?*mut Handle = Pointer.null<Handle>() drop l2
    let mut bestDue: u64 = 0 let mut bestOrder: u64 = 0
    while !Pointer.isNull<Handle>(cursor) {
      let c = unsafe Pointer.borrow<(), Handle>(&anchor, unsafe nn(cursor))
      if c.due <= now && c.serial != serial && (Pointer.isNull<Handle>(due) || c.due < bestDue || (c.due == bestDue && c.order < bestOrder)) { due = cursor bestDue = c.due bestOrder = c.order }
      cursor = c.nextTimer
    }
    if Pointer.isNull<Handle>(due) { return }
    let mut second = () let d = unsafe Pointer.borrowMut<(), Handle>(&mut second, unsafe nn(due))
    d.serial = serial let kind = d.kind drop d
    if kind == UV_TIMER { unsafe timerTick(loop, unsafe nn(due)) } else { unsafe pollTick(loop, unsafe nn(due)) }
  }
}

// ---- Run --------------------------------------------------------------------------------------
unsafe fn ioPoll(loop: *mut Loop, timeout: i64) -> () {
  let mut anchor = () let l = unsafe Pointer.borrowMut<(), Loop>(&mut anchor, loop)
  let queue = l.backend let metrics = l.idleMetrics && timeout != 0 drop l
  let mut ready: [Ready; 64] = [Ready { tag: 0, events: 0 }; 64]
  let before = if metrics { unsafe hrtime() } else { 0 }
  let count = unsafe queueWait(queue, &mut ready, timeout)
  if metrics { let l2 = unsafe Pointer.borrowMut<(), Loop>(&mut anchor, loop) l2.idleTime = l2.idleTime + (unsafe hrtime() - before) }
  if timeout != 0 { unsafe updateTime(loop) }
  let mut index: usize = 0
  while index < i32.toUsize(count) {
    let item = ready[index]
    index = index + 1
    if item.tag == TAG_WAKE { unsafe asyncReady(loop) continue }
    if item.tag == TAG_SIGNAL { unsafe signalReady(loop) continue }
    if item.tag == TAG_INOTIFY { unsafe notifyReady(loop) continue }
    let target = unsafe addressPointer(item.tag)
    if Pointer.isNull<u8>(target) { continue }
    let handle = unsafe handleOf(unsafe nn(target))
    let second = () let h = unsafe Pointer.borrow<(), Handle>(&second, handle)
    let kind = h.kind drop h
    if kind == UV_POLL { unsafe pollReady(handle, item.events) }
    static if Intrinsic.targetOperatingSystem() == "darwin" { if kind == UV_FS_EVENT { unsafe vnodeReady(handle, u32.shiftRight(i32.toU32(item.events), 16)) } }
  }
}
/// Runs the loop: `UV_RUN_DEFAULT` (0) until nothing referenced is active or `uv_stop`,
/// `UV_RUN_ONCE` (1) for one iteration that may wait, `UV_RUN_NOWAIT` (2) for one that does not.
/// Returns whether the loop is still alive.
pub unsafe fn uv_run(memory: *mut u8, mode: i32) -> i32 {
  let loop = unsafe loopOf(memory)
  let mut anchor = ()
  let mut running = unsafe alive(loop)
  if !running { unsafe updateTime(loop) }
  while running {
    let l = unsafe Pointer.borrow<(), Loop>(&anchor, loop)
    if l.stopped { break }
    drop l
    unsafe updateTime(loop)
    unsafe runTimers(loop)
    let mut timeout: i64 = 0
    if mode != UV_RUN_NOWAIT { timeout = i32.toI64(unsafe uv_backend_timeout(memory)) }
    unsafe ioPoll(loop, timeout)
    unsafe runClosing(loop)
    if mode == UV_RUN_ONCE { unsafe updateTime(loop) unsafe runTimers(loop) }
    running = unsafe alive(loop)
    if mode != UV_RUN_DEFAULT { break }
  }
  let mut second = () let l2 = unsafe Pointer.borrowMut<(), Loop>(&mut second, loop)
  l2.stopped = false
  if running { return 1 }
  return 0
}
