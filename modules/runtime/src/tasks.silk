//! The runtime's tasks, run with `silk task <name>` from `modules/runtime`.
//!
//! `build` is how the runtime executable is made: a plain `silk build` with the Clang driver in
//! `tools/clang.py`, then a second link with the built-ins' bytecode and a heap image appended,
//! which only an executable that runs on the build machine can make. The work stays in the
//! Python tools; this program is their entry point.
//!
//! The `bench` tasks run `tools/bench.py`, which sets up and runs the comparison with Bun
//! (`bench/README.md`).

import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem }
import silk.system.host_input { HostInput, HostInputError }

union Tasks {
  Build { pub release: bool, pub output: Option<Bytes> },
  Embed,
  Compat { pub pattern: Option<Bytes> },
  Sea { pub runtime: Bytes, pub blob: Bytes, pub executable: Bytes, pub sign: Option<Bytes> },
  BenchSetup { pub setupWork: Option<Bytes>, pub steps: List<Bytes> },
  Bench {
    pub benchRounds: Option<Bytes>,
    pub benchRuntime: Option<Bytes>,
    pub benchRuntimes: Option<Bytes>,
    pub benchOut: Option<Bytes>,
    pub benchWork: Option<Bytes>,
    pub benchForce: bool,
    pub groups: List<Bytes>,
  },
  BenchMem {
    pub memRounds: Option<Bytes>,
    pub memRuntime: Option<Bytes>,
    pub memRuntimes: Option<Bytes>,
    pub memOut: Option<Bytes>,
    pub memWork: Option<Bytes>,
    pub memForce: bool,
  },
  BenchCold {
    pub coldRounds: Option<Bytes>,
    pub coldRuntime: Option<Bytes>,
    pub coldRuntimes: Option<Bytes>,
    pub coldOut: Option<Bytes>,
    pub coldWork: Option<Bytes>,
    pub coldForce: bool,
    pub cases: List<Bytes>,
  },
  BenchAll {
    pub allRounds: Option<Bytes>,
    pub allMemRounds: Option<Bytes>,
    pub allColdRuns: Option<Bytes>,
    pub allRuntime: Option<Bytes>,
    pub allRuntimes: Option<Bytes>,
    pub allOut: Option<Bytes>,
    pub allWork: Option<Bytes>,
    pub allForce: bool,
  },
  OfflineDeps { pub archives: Option<Bytes>, pub depsWork: Option<Bytes> },
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "The SilkJS runtime's tasks")
      |> Command.variant("Build", "Build the runtime executable, build/silkjsruntime")
      |> Command.option("release", Opt.about("Optimize for speed"))
      |> Command.option("output", Opt.about("Where to write the executable"))
      |> Command.variant("Embed", "Regenerate the built-ins index (builtin_sources.c, src/runtime/embedded.silk) after adding or removing a built-in")
      |> Command.variant(
        "Compat",
        "Run the differential cases against Node 24 (needs node; SILKJS_RUNTIME and NODE_REFERENCE select executables)",
      )
      |> Command.arg("pattern", Opt.about("A regular expression selecting cases"))
      |> Command.variant("Sea", "Inject a prepared single-executable blob into a Darwin arm64 runtime and sign it")
      |> Command.option("runtime", Opt.about("The runtime executable to start from") |> Opt.required)
      |> Command.option("blob", Opt.about("The blob from --experimental-sea-config") |> Opt.required)
      |> Command.option("executable", Opt.about("The executable to write") |> Opt.required)
      |> Command.option("sign", Opt.about("The codesign identity (default: ad-hoc)"))
      |> Command.variant(
        "BenchSetup",
        "Prepare the Bun comparison: wrk, Postgres, Bun's bench folders, Northwind, the TLS certificate, the 1 GB file",
      )
      |> Command.option("setupWork", Opt.about("The work directory (default: SILKJS_BENCH_WORK, else build/bench)") |> Opt.long("work"))
      |> Command.arg("steps", Opt.about("Steps to run (default all): wrk postgres bunrepo install northwind cert bigfile"))
      |> Command.variant(
        "Bench",
        "Run the benchmarks against Bun with its JIT off (needs bench-setup and a release build); writes results.csv",
      )
      |> Command.option("benchRounds", Opt.about("Interleaved rounds (default 6)") |> Opt.long("rounds"))
      |> Command.option("benchRuntime", Opt.about("The runtime executable (default: SILKJS_RUNTIME, else build/silkjsruntime)") |> Opt.long("runtime"))
      |> Command.option("benchRuntimes", Opt.about("Columns, comma-separated (default: silkjs,bun_nojit,bun_nojit_smol)") |> Opt.long("runtimes"))
      |> Command.option("benchOut", Opt.about("Where to write results (default: <work>/results/<UTC time>)") |> Opt.long("out"))
      |> Command.option("benchWork", Opt.about("The work directory of bench-setup (default: SILKJS_BENCH_WORK, else build/bench)") |> Opt.long("work"))
      |> Command.option("benchForce", Opt.about("Measure even while a build runs or the host is busy") |> Opt.long("force"))
      |> Command.arg("groups", Opt.about("Groups or benchmarks to run: http ws pg sqlite spawn cat imm"))
      |> Command.variant("BenchMem", "Measure the peak RSS of the non-server benchmarks")
      |> Command.option("memRounds", Opt.about("Interleaved rounds (default 3)") |> Opt.long("rounds"))
      |> Command.option("memRuntime", Opt.about("The runtime executable (default: SILKJS_RUNTIME, else build/silkjsruntime)") |> Opt.long("runtime"))
      |> Command.option("memRuntimes", Opt.about("Columns, comma-separated (default: silkjs,bun_nojit,bun_nojit_smol)") |> Opt.long("runtimes"))
      |> Command.option("memOut", Opt.about("Where to write results (default: <work>/results/<UTC time>)") |> Opt.long("out"))
      |> Command.option("memWork", Opt.about("The work directory of bench-setup (default: SILKJS_BENCH_WORK, else build/bench)") |> Opt.long("work"))
      |> Command.option("memForce", Opt.about("Measure even while a build runs or the host is busy") |> Opt.long("force"))
      |> Command.variant("BenchCold", "Measure cold start: wall time, CPU time, peak RSS and page faults per process start")
      |> Command.option("coldRounds", Opt.about("Runs per case (default 30)") |> Opt.long("rounds"))
      |> Command.option("coldRuntime", Opt.about("The runtime executable (default: SILKJS_RUNTIME, else build/silkjsruntime)") |> Opt.long("runtime"))
      |> Command.option("coldRuntimes", Opt.about("Columns, comma-separated (default: silkjs,bun_nojit,bun_nojit_smol)") |> Opt.long("runtimes"))
      |> Command.option("coldOut", Opt.about("Where to write results (default: <work>/results/<UTC time>)") |> Opt.long("out"))
      |> Command.option("coldWork", Opt.about("The work directory of bench-setup (default: SILKJS_BENCH_WORK, else build/bench)") |> Opt.long("work"))
      |> Command.option("coldForce", Opt.about("Measure even while a build runs or the host is busy") |> Opt.long("force"))
      |> Command.arg("cases", Opt.about("Cases to run: empty hello cjs esm local fsread net timer"))
      |> Command.variant("BenchAll", "Run bench, bench-mem and bench-cold into one results directory")
      |> Command.option("allRounds", Opt.about("Rounds of bench (default 6)") |> Opt.long("rounds"))
      |> Command.option("allRuntime", Opt.about("The runtime executable (default: SILKJS_RUNTIME, else build/silkjsruntime)") |> Opt.long("runtime"))
      |> Command.option("allRuntimes", Opt.about("Columns, comma-separated (default: silkjs,bun_nojit,bun_nojit_smol)") |> Opt.long("runtimes"))
      |> Command.option("allOut", Opt.about("Where to write results (default: <work>/results/<UTC time>)") |> Opt.long("out"))
      |> Command.option("allWork", Opt.about("The work directory of bench-setup (default: SILKJS_BENCH_WORK, else build/bench)") |> Opt.long("work"))
      |> Command.option("allForce", Opt.about("Measure even while a build runs or the host is busy") |> Opt.long("force"))
      |> Command.option("allMemRounds", Opt.about("Rounds of bench-mem (default 3)") |> Opt.long("mem-rounds"))
      |> Command.option("allColdRuns", Opt.about("Runs per case of bench-cold (default 30)") |> Opt.long("cold-runs"))
      |> Command.variant(
        "OfflineDeps",
        "Point the build at prepared copies of its downloads, for a network that blocks them",
      )
      |> Command.option("archives", Opt.about("The folder with the prepared archives (default: SILKJS_OFFLINE_DEPS)") |> Opt.long("from"))
      |> Command.option("depsWork", Opt.about("The work directory (default: SILKJS_BENCH_WORK, else build/bench)") |> Opt.long("work"))
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    let mut argv = List<Bytes>.make()
    match move self {
      Tasks.Build { release, output } => {
        run word(&mut argv, b"tools/build.py")
        if release { run word(&mut argv, b"--release") }
        run valued(&mut argv, b"--output", move output)
      }
      Tasks.Embed => run word(&mut argv, b"tools/embed.py")
      Tasks.Compat { pattern } => {
        run word(&mut argv, b"tests/compat.mjs")
        match move pattern {
          Option<Bytes>.Some { value } => run List<Bytes>.append(&mut argv, move value)
          Option<Bytes>.None => {}
        }
        run Task.execBytes(b"node", List<Bytes>.asSlice(&argv))
        return
      }
      Tasks.Sea { runtime: base, blob, executable, sign } => {
        run word(&mut argv, b"tools/sea.py")
        run word(&mut argv, b"--runtime")
        run List<Bytes>.append(&mut argv, move base)
        run word(&mut argv, b"--blob")
        run List<Bytes>.append(&mut argv, move blob)
        run word(&mut argv, b"--output")
        run List<Bytes>.append(&mut argv, move executable)
        run valued(&mut argv, b"--sign", move sign)
      }
      Tasks.BenchSetup { setupWork, steps } => {
        run benchTool(&mut argv, b"setup")
        run valued(&mut argv, b"--work", move setupWork)
        run words(&mut argv, &steps)
      }
      Tasks.Bench { benchRounds, benchRuntime, benchRuntimes, benchOut, benchWork, benchForce, groups } => {
        run benchTool(&mut argv, b"run")
        run measured(&mut argv, move benchRounds, move benchRuntime, move benchRuntimes, move benchOut, move benchWork, benchForce)
        run words(&mut argv, &groups)
      }
      Tasks.BenchMem { memRounds, memRuntime, memRuntimes, memOut, memWork, memForce } => {
        run benchTool(&mut argv, b"mem")
        run measured(&mut argv, move memRounds, move memRuntime, move memRuntimes, move memOut, move memWork, memForce)
      }
      Tasks.BenchCold { coldRounds, coldRuntime, coldRuntimes, coldOut, coldWork, coldForce, cases } => {
        run benchTool(&mut argv, b"cold")
        run measured(&mut argv, move coldRounds, move coldRuntime, move coldRuntimes, move coldOut, move coldWork, coldForce)
        run words(&mut argv, &cases)
      }
      Tasks.BenchAll { allRounds, allMemRounds, allColdRuns, allRuntime, allRuntimes, allOut, allWork, allForce } => {
        run benchTool(&mut argv, b"all")
        run measured(&mut argv, move allRounds, move allRuntime, move allRuntimes, move allOut, move allWork, allForce)
        run valued(&mut argv, b"--mem-rounds", move allMemRounds)
        run valued(&mut argv, b"--cold-runs", move allColdRuns)
      }
      Tasks.OfflineDeps { archives, depsWork } => {
        run benchTool(&mut argv, b"deps")
        run valued(&mut argv, b"--from", move archives)
        run valued(&mut argv, b"--work", move depsWork)
      }
    }
    run Task.execBytes(b"python3", List<Bytes>.asSlice(&argv))
  }
}

pub effect fn main() -> i32 ? &mut HostInput {
  return run Task.main<Tasks>()
}

// Appends one argument.
effect fn word(argv: &mut List<Bytes>, text: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run List<Bytes>.append(&mut argv.*, run Bytes.copy(text))
}

// Starts a `tools/bench.py` command.
effect fn benchTool(argv: &mut List<Bytes>, command: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run word(&mut argv.*, b"tools/bench.py")
  run word(&mut argv.*, command)
}

// Appends the options the measuring commands of `tools/bench.py` share.
effect fn measured(
  argv: &mut List<Bytes>,
  rounds: Option<Bytes>,
  executable: Option<Bytes>,
  runtimes: Option<Bytes>,
  output: Option<Bytes>,
  workDir: Option<Bytes>,
  forced: bool,
) -> () ! OutOfMemoryError ? &mut Allocator {
  run valued(&mut argv.*, b"--rounds", move rounds)
  run valued(&mut argv.*, b"--runtime", move executable)
  run valued(&mut argv.*, b"--runtimes", move runtimes)
  run valued(&mut argv.*, b"--out", move output)
  run valued(&mut argv.*, b"--work", move workDir)
  if forced { run word(&mut argv.*, b"--force") }
}

// Appends a copy of each argument in `values`.
effect fn words(argv: &mut List<Bytes>, values: &List<Bytes>) -> () ! OutOfMemoryError ? &mut Allocator {
  let listed = List<Bytes>.asSlice(values)
  let mut at: usize = 0
  while at < listed.length {
    run word(&mut argv.*, Bytes.asSlice(&listed[at]))
    at = at + 1
  }
}

// Appends `flag` and its value when the option was given.
effect fn valued(argv: &mut List<Bytes>, flag: &[u8], value: Option<Bytes>) -> () ! OutOfMemoryError ? &mut Allocator {
  match move value {
    Option<Bytes>.Some { value: given } => {
      run word(&mut argv.*, flag)
      run List<Bytes>.append(&mut argv.*, move given)
    }
    Option<Bytes>.None => {}
  }
}
