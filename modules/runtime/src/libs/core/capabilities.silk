//! The runtime's capabilities: what an embedder chooses when it starts a runtime
//! (docs/composable-runtime.md).
//!
//! Each capability is an interface with a real implementation, the embedder's own, or the
//! empty one shipped here. An embedder names one implementation per capability in a
//! [`Capabilities`] value, and the runtime is generic over that type: `Services<C>`, with
//! `C: Composition`. Whether a capability is there is a constant of its implementation's type
//! (`Wasm.present`), and the runtime's code for it sits under `static if`, so with the empty
//! implementation that code is not compiled, and the package that holds the real one, with its
//! C library, is not a dependency of the program.
//!
//! The list is closed: [`Composition`] names every capability, and a new one is a new field of
//! [`Capabilities`] that every embedder must then fill.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.ownership { Copy }
import silk.collections.list { List }
import silkjs.js_engine { Engine }
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_realm { Realm, Arguments }
import silkjs.js_core_types { FrameSlots }
import silkjs.js_exceptions { JsException }
import silkjs.js_gc { Tracer }
import silkjs.js_runtime_registry { ClassIdAllocator }
import ext.diagnostics_fatal { RuntimeHeap }
import libs.core.host { Services }

/// The first native function id that belongs to the embedder's [`HostApi`]: `NativeFunctionId.Host`
/// ids from here on reach its `call`.
pub const HOST_API_FIRST: u32 = 1000000

/// WebAssembly and WASI: `WebAssembly`, `node:wasi`. Native ids 9000 to 9002 and 10000, and the
/// engine classes 9096 to 9098, are this capability's.
///
/// A real implementation keeps its native state behind pointers, so it is `Copy`: the runtime
/// copies it out of the services to call it with the engine.
pub interface Wasm {
  /// A constant of the implementation type. False means `WebAssembly` and `node:wasi` are not
  /// there: no native function, class or loop turn of theirs is registered, and the code behind
  /// them is not compiled.
  static fn present() -> bool
  /// The instance a new worker thread starts with, made from its parent's: nothing opened yet.
  fn forWorker(self: &Self) -> Self
  /// Opens this runtime's native state, before the bootstrap runs.
  effect fn open(self: &mut Self, allocator: *mut RuntimeHeap) -> () ! OutOfMemoryError
  /// Registers the engine classes in a runtime that did not start from a heap image.
  unsafe effect fn install(self: &Self, rt: *mut HeapHeader, namespace: &ClassIdAllocator) -> () ! OutOfMemoryError ? &mut Allocator
  /// Takes back the engine classes a heap image recorded ([`Wasm.classIds`]).
  unsafe fn adoptClasses(self: &Self, rt: *mut HeapHeader, ids: [u32; 2]) -> ()
  /// The engine classes, for a heap image to record.
  unsafe fn classIds(self: &Self) -> [u32; 2]
  /// Completions are waiting for the loop's poll phase.
  unsafe fn ready(self: &Self) -> bool
  /// Delivers waiting completions. True when something ran.
  unsafe effect fn poll<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator
  /// Native function `id`: 9000 (`wasmNative`) or 10000 (`wasiNative`).
  unsafe effect fn call<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, id: u32, argc: i32, argv: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator
  /// Native data function `id`: 9001 (an export's call) or 9002 (an import's settlement).
  unsafe effect fn callData<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, id: u32, argc: i32, argv: &FrameSlots, captured: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator
  /// A property write on an object of class 9096 (Wasm GC objects are immutable from JavaScript).
  unsafe effect fn rejectMutation<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> bool ! JsException ? &mut Allocator
  /// The engine's tracer for objects of class 9097.
  unsafe fn trace(self: &Self, rt: *mut HeapHeader, object: *mut HeapHeader, tracer: &mut Tracer) -> ()
  /// The engine's finalizer for objects of class 9098.
  unsafe fn finalize<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, rt: *mut HeapHeader, object: *mut HeapHeader) -> ()
  /// WASI handles still open, for the report of what keeps the loop alive.
  unsafe fn openHandles(self: &Self) -> usize
  /// Closes WASI's state.
  unsafe fn closeWasi<'m, C: Composition>(self: &mut Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> ()
  /// Closes WebAssembly's state.
  unsafe fn close<'m, C: Composition>(self: &mut Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> ()
}

/// No WebAssembly: `typeof WebAssembly` is `'undefined'` and `node:wasi` does not load. Its
/// operations are never called, because `present` is false.
pub struct EmptyWasm {}
impl Copy for EmptyWasm {}
impl Wasm for EmptyWasm {
  static fn present() -> bool { return false }
  fn forWorker(self: &Self) -> Self { return EmptyWasm {} }
  effect fn open(self: &mut Self, allocator: *mut RuntimeHeap) -> () ! OutOfMemoryError {}
  unsafe effect fn install(self: &Self, rt: *mut HeapHeader, namespace: &ClassIdAllocator) -> () ! OutOfMemoryError ? &mut Allocator {}
  unsafe fn adoptClasses(self: &Self, rt: *mut HeapHeader, ids: [u32; 2]) -> () {}
  unsafe fn classIds(self: &Self) -> [u32; 2] { return [0, 0] }
  unsafe fn ready(self: &Self) -> bool { return false }
  unsafe effect fn poll<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> bool
    ! OutOfMemoryError | JsException ? &mut Allocator { return false }
  unsafe effect fn call<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, id: u32, argc: i32, argv: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("WebAssembly is not part of this runtime") }
  unsafe effect fn callData<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader, id: u32, argc: i32, argv: &FrameSlots, captured: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator { return Intrinsic.trap("WebAssembly is not part of this runtime") }
  unsafe effect fn rejectMutation<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> bool ! JsException ? &mut Allocator { return Intrinsic.trap("WebAssembly is not part of this runtime") }
  unsafe fn trace(self: &Self, rt: *mut HeapHeader, object: *mut HeapHeader, tracer: &mut Tracer) -> () { return Intrinsic.trap("WebAssembly is not part of this runtime") }
  unsafe fn finalize<'m, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, rt: *mut HeapHeader, object: *mut HeapHeader) -> () { return Intrinsic.trap("WebAssembly is not part of this runtime") }
  unsafe fn openHandles(self: &Self) -> usize { return 0 }
  unsafe fn closeWasi<'m, C: Composition>(self: &mut Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> () {}
  unsafe fn close<'m, C: Composition>(self: &mut Self, engine: &mut Engine<'m, Services<C>>, context: *mut HeapHeader) -> () {}
}

/// The embedder's own native functions: `NativeFunctionId.Host` ids [`HOST_API_FIRST`] and up
/// reach `call`. It replaces the earlier `Embedder` hook and its C function pointer.
///
/// An implementation keeps what it needs behind pointers, so it is `Copy`: the runtime copies it
/// out of the services to call it with the engine.
pub interface HostApi {
  /// The instance a new worker thread starts with, made from its parent's. Worker threads have
  /// not had the host's functions so far; an implementation that has nothing for them gives an
  /// inert copy.
  fn forWorker(self: &Self) -> Self
  /// Native function `id` ([`HOST_API_FIRST`] or more) called in `realm`.
  effect fn call<'r, 'm, 'w, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, id: u32, realm: Realm<'r>, argc: i32, argv: Arguments<'w>) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator
}

/// No functions of the host's: its ids return undefined.
pub struct EmptyHostApi {}
impl Copy for EmptyHostApi {}
impl HostApi for EmptyHostApi {
  fn forWorker(self: &Self) -> Self { return EmptyHostApi {} }
  effect fn call<'r, 'm, 'w, C: Composition>(self: &Self, engine: &mut Engine<'m, Services<C>>, id: u32, realm: Realm<'r>, argc: i32, argv: Arguments<'w>) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator { return ValueBits.Undefined }
}

/// The process the runtime sees: its environment (`process.env`), its working directory
/// (`process.cwd`, `process.chdir`) and exit. Native id 19100 (`platformNative`) is this
/// capability's. There is no empty implementation: a runtime always has these.
///
/// `OsPlatform` (`libs/core/platforms.silk`) is the process's own; `FixedPlatform` is fixed by
/// the embedder. Failures are negative errno values.
pub interface Platform {
  /// The instance a new worker thread starts with, made from its parent's.
  fn forWorker(self: &Self) -> Self
  /// Appends the value of the environment variable `name` to `into`; false when it is not set.
  effect fn getenv(self: &Self, name: &[u8], into: &mut List<u8>) -> bool ! OutOfMemoryError ? &mut Allocator
  /// Sets the environment variable `name`: 0, or a negative errno.
  effect fn setenv(self: &Self, name: &[u8], value: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator
  /// Removes the environment variable `name`: 0, or a negative errno.
  effect fn unsetenv(self: &Self, name: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator
  /// Appends the name of every environment variable to `into`, each followed by a NUL.
  effect fn environmentNames(self: &Self, into: &mut List<u8>) -> () ! OutOfMemoryError ? &mut Allocator
  /// Appends the working directory to `into`, or returns a negative errno.
  effect fn cwd(self: &Self, into: &mut List<u8>) -> i32 ! OutOfMemoryError ? &mut Allocator
  /// Changes the working directory: 0, or a negative errno.
  effect fn chdir(self: &Self, path: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator
  /// Ends the process with `status`. An embedded runtime has ended itself before this is called.
  fn exit(self: &Self, status: i32) -> never
}

/// The file type bits ([`ModuleResolver.kind`]) of a regular file.
pub const MODULE_FILE: i32 = 0o100000
/// The file type bits of a directory.
pub const MODULE_DIRECTORY: i32 = 0o040000
/// The file type bits of a symbolic link, when `kind` does not follow it.
pub const MODULE_LINK: i32 = 0o120000

/// Where `require` and `import` find modules: the loader resolves as Node's does and asks this
/// for what it needs of the files, the type of a path, its real path and its source. Native id
/// 19000 (`moduleNative`) is this capability's. There is no empty implementation: a runtime
/// always loads its main module from somewhere.
///
/// `NodeResolution` (`libs/core/module_sources.silk`) reads the operating system's files;
/// `MemoryModules` serves a graph bundled into the program. Failures are negative errno values.
pub interface ModuleResolver {
  /// The instance a new worker thread starts with, made from its parent's.
  fn forWorker(self: &Self) -> Self
  /// The file type bits of `path` (`mode & 0o170000`, [`MODULE_FILE`] and the others), following
  /// a final symbolic link when `follow`, or a negative errno.
  effect fn kind(self: &Self, path: &[u8], follow: bool) -> i32 ! OutOfMemoryError ? &mut Allocator
  /// Appends the canonical path of `path` to `into`, or returns a negative errno.
  effect fn realpath(self: &Self, path: &[u8], into: &mut List<u8>) -> i32 ! OutOfMemoryError ? &mut Allocator
  /// Appends the contents of the file at `path` to `into`, or returns a negative errno.
  effect fn read(self: &Self, path: &[u8], into: &mut List<u8>) -> i32 ! OutOfMemoryError ? &mut Allocator
}

/// What an embedder provides: one implementation per capability. Every field is required;
/// a capability the program does not want is given its empty implementation.
///
/// ```silk
/// let capabilities = Capabilities { platform: OsPlatform {}, modules: NodeResolution {}, wasm: EmptyWasm {}, hostApi: EmptyHostApi {} }
/// ```
pub struct Capabilities<P, M, W, A> {
  pub platform: P,
  pub modules: M,
  pub wasm: W,
  pub hostApi: A,
}

/// The closed list of capabilities, as the runtime reaches them: implemented by
/// [`Capabilities`] alone, so the runtime is generic over one type however many capabilities
/// there are. Each operation forwards to that capability's implementation.
pub interface Composition {
  /// `Wasm.present` of the program's Wasm implementation.
  static fn wasmPresent() -> bool
  /// The capabilities a new worker thread starts with, made from its parent's.
  fn forWorker(self: &Self) -> Self
  effect fn platformGetenv<'m>(engine: &Engine<'m, Services<Self>>, name: &[u8], into: &mut List<u8>) -> bool ! OutOfMemoryError ? &mut Allocator
  effect fn platformSetenv<'m>(engine: &Engine<'m, Services<Self>>, name: &[u8], value: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator
  effect fn platformUnsetenv<'m>(engine: &Engine<'m, Services<Self>>, name: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator
  effect fn platformNames<'m>(engine: &Engine<'m, Services<Self>>, into: &mut List<u8>) -> () ! OutOfMemoryError ? &mut Allocator
  effect fn platformCwd<'m>(engine: &Engine<'m, Services<Self>>, into: &mut List<u8>) -> i32 ! OutOfMemoryError ? &mut Allocator
  effect fn platformChdir<'m>(engine: &Engine<'m, Services<Self>>, path: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator
  fn platformExit<'m>(engine: &Engine<'m, Services<Self>>, status: i32) -> never
  effect fn modulesKind<'m>(engine: &Engine<'m, Services<Self>>, path: &[u8], follow: bool) -> i32 ! OutOfMemoryError ? &mut Allocator
  effect fn modulesRealpath<'m>(engine: &Engine<'m, Services<Self>>, path: &[u8], into: &mut List<u8>) -> i32 ! OutOfMemoryError ? &mut Allocator
  effect fn modulesRead<'m>(engine: &Engine<'m, Services<Self>>, path: &[u8], into: &mut List<u8>) -> i32 ! OutOfMemoryError ? &mut Allocator
  effect fn wasmOpen<'m>(engine: &mut Engine<'m, Services<Self>>, allocator: *mut RuntimeHeap) -> () ! OutOfMemoryError
  unsafe effect fn wasmInstall<'m>(engine: &mut Engine<'m, Services<Self>>, rt: *mut HeapHeader, namespace: &ClassIdAllocator) -> () ! OutOfMemoryError ? &mut Allocator
  unsafe fn wasmAdoptClasses<'m>(engine: &mut Engine<'m, Services<Self>>, rt: *mut HeapHeader, ids: [u32; 2]) -> ()
  unsafe fn wasmClassIds<'m>(engine: &Engine<'m, Services<Self>>) -> [u32; 2]
  unsafe fn wasmReady<'m>(engine: &Engine<'m, Services<Self>>) -> bool
  unsafe effect fn wasmPoll<'m>(engine: &mut Engine<'m, Services<Self>>, context: *mut HeapHeader) -> bool ! OutOfMemoryError | JsException ? &mut Allocator
  unsafe effect fn wasmCall<'m>(engine: &mut Engine<'m, Services<Self>>, context: *mut HeapHeader, id: u32, argc: i32, argv: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator
  unsafe effect fn wasmCallData<'m>(engine: &mut Engine<'m, Services<Self>>, context: *mut HeapHeader, id: u32, argc: i32, argv: &FrameSlots, captured: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator
  unsafe effect fn wasmRejectMutation<'m>(engine: &mut Engine<'m, Services<Self>>, context: *mut HeapHeader) -> bool ! JsException ? &mut Allocator
  unsafe fn wasmTrace<'m>(engine: &mut Engine<'m, Services<Self>>, rt: *mut HeapHeader, object: *mut HeapHeader, tracer: &mut Tracer) -> ()
  unsafe fn wasmFinalize<'m>(engine: &mut Engine<'m, Services<Self>>, rt: *mut HeapHeader, object: *mut HeapHeader) -> ()
  unsafe fn wasmOpenHandles<'m>(engine: &Engine<'m, Services<Self>>) -> usize
  unsafe fn wasmCloseWasi<'m>(engine: &mut Engine<'m, Services<Self>>, context: *mut HeapHeader) -> ()
  unsafe fn wasmClose<'m>(engine: &mut Engine<'m, Services<Self>>, context: *mut HeapHeader) -> ()
  effect fn hostCall<'r, 'm, 'w>(engine: &mut Engine<'m, Services<Self>>, id: u32, realm: Realm<'r>, argc: i32, argv: Arguments<'w>) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator
}

static fn presentOf<W: Wasm>() -> bool { return Wasm.present() }

impl<P: Platform + Copy, M: ModuleResolver + Copy, W: Wasm + Copy, A: HostApi + Copy> Composition for Capabilities<P, M, W, A> {
  static fn wasmPresent() -> bool { return presentOf<W>() }
  fn forWorker(self: &Self) -> Self {
    return Capabilities<P, M, W, A> { platform: self.platform.forWorker(), modules: self.modules.forWorker(), wasm: self.wasm.forWorker(), hostApi: self.hostApi.forWorker() }
  }
  effect fn platformGetenv<'m>(engine: &Engine<'m, Services<Self>>, name: &[u8], into: &mut List<u8>) -> bool ! OutOfMemoryError ? &mut Allocator {
    let platform = engine.services.capabilities.platform return run platform.getenv(name, &mut into.*)
  }
  effect fn platformSetenv<'m>(engine: &Engine<'m, Services<Self>>, name: &[u8], value: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator {
    let platform = engine.services.capabilities.platform return run platform.setenv(name, value)
  }
  effect fn platformUnsetenv<'m>(engine: &Engine<'m, Services<Self>>, name: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator {
    let platform = engine.services.capabilities.platform return run platform.unsetenv(name)
  }
  effect fn platformNames<'m>(engine: &Engine<'m, Services<Self>>, into: &mut List<u8>) -> () ! OutOfMemoryError ? &mut Allocator {
    let platform = engine.services.capabilities.platform run platform.environmentNames(&mut into.*)
  }
  effect fn platformCwd<'m>(engine: &Engine<'m, Services<Self>>, into: &mut List<u8>) -> i32 ! OutOfMemoryError ? &mut Allocator {
    let platform = engine.services.capabilities.platform return run platform.cwd(&mut into.*)
  }
  effect fn platformChdir<'m>(engine: &Engine<'m, Services<Self>>, path: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator {
    let platform = engine.services.capabilities.platform return run platform.chdir(path)
  }
  fn platformExit<'m>(engine: &Engine<'m, Services<Self>>, status: i32) -> never {
    let platform = engine.services.capabilities.platform return platform.exit(status)
  }
  effect fn modulesKind<'m>(engine: &Engine<'m, Services<Self>>, path: &[u8], follow: bool) -> i32 ! OutOfMemoryError ? &mut Allocator {
    let modules = engine.services.capabilities.modules return run modules.kind(path, follow)
  }
  effect fn modulesRealpath<'m>(engine: &Engine<'m, Services<Self>>, path: &[u8], into: &mut List<u8>) -> i32 ! OutOfMemoryError ? &mut Allocator {
    let modules = engine.services.capabilities.modules return run modules.realpath(path, &mut into.*)
  }
  effect fn modulesRead<'m>(engine: &Engine<'m, Services<Self>>, path: &[u8], into: &mut List<u8>) -> i32 ! OutOfMemoryError ? &mut Allocator {
    let modules = engine.services.capabilities.modules return run modules.read(path, &mut into.*)
  }
  effect fn wasmOpen<'m>(engine: &mut Engine<'m, Services<Self>>, allocator: *mut RuntimeHeap) -> () ! OutOfMemoryError {
    run engine.services.capabilities.wasm.open(allocator)
  }
  unsafe effect fn wasmInstall<'m>(engine: &mut Engine<'m, Services<Self>>, rt: *mut HeapHeader, namespace: &ClassIdAllocator) -> () ! OutOfMemoryError ? &mut Allocator {
    let wasm = engine.services.capabilities.wasm run unsafe wasm.install(rt, namespace)
  }
  unsafe fn wasmAdoptClasses<'m>(engine: &mut Engine<'m, Services<Self>>, rt: *mut HeapHeader, ids: [u32; 2]) -> () {
    let wasm = engine.services.capabilities.wasm unsafe wasm.adoptClasses(rt, ids)
  }
  unsafe fn wasmClassIds<'m>(engine: &Engine<'m, Services<Self>>) -> [u32; 2] { let wasm = engine.services.capabilities.wasm return unsafe wasm.classIds() }
  unsafe fn wasmReady<'m>(engine: &Engine<'m, Services<Self>>) -> bool { let wasm = engine.services.capabilities.wasm return unsafe wasm.ready() }
  unsafe effect fn wasmPoll<'m>(engine: &mut Engine<'m, Services<Self>>, context: *mut HeapHeader) -> bool ! OutOfMemoryError | JsException ? &mut Allocator {
    let wasm = engine.services.capabilities.wasm return run unsafe wasm.poll(&mut engine, context)
  }
  unsafe effect fn wasmCall<'m>(engine: &mut Engine<'m, Services<Self>>, context: *mut HeapHeader, id: u32, argc: i32, argv: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    let wasm = engine.services.capabilities.wasm return run unsafe wasm.call(&mut engine, context, id, argc, argv)
  }
  unsafe effect fn wasmCallData<'m>(engine: &mut Engine<'m, Services<Self>>, context: *mut HeapHeader, id: u32, argc: i32, argv: &FrameSlots, captured: &FrameSlots) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    let wasm = engine.services.capabilities.wasm return run unsafe wasm.callData(&mut engine, context, id, argc, argv, captured)
  }
  unsafe effect fn wasmRejectMutation<'m>(engine: &mut Engine<'m, Services<Self>>, context: *mut HeapHeader) -> bool ! JsException ? &mut Allocator {
    let wasm = engine.services.capabilities.wasm return run unsafe wasm.rejectMutation(&mut engine, context)
  }
  unsafe fn wasmTrace<'m>(engine: &mut Engine<'m, Services<Self>>, rt: *mut HeapHeader, object: *mut HeapHeader, tracer: &mut Tracer) -> () {
    let wasm = engine.services.capabilities.wasm unsafe wasm.trace(rt, object, &mut tracer)
  }
  unsafe fn wasmFinalize<'m>(engine: &mut Engine<'m, Services<Self>>, rt: *mut HeapHeader, object: *mut HeapHeader) -> () {
    let wasm = engine.services.capabilities.wasm unsafe wasm.finalize(&mut engine, rt, object)
  }
  unsafe fn wasmOpenHandles<'m>(engine: &Engine<'m, Services<Self>>) -> usize { let wasm = engine.services.capabilities.wasm return unsafe wasm.openHandles() }
  unsafe fn wasmCloseWasi<'m>(engine: &mut Engine<'m, Services<Self>>, context: *mut HeapHeader) -> () {
    let mut wasm = engine.services.capabilities.wasm unsafe wasm.closeWasi(&mut engine, context) engine.services.capabilities.wasm = wasm
  }
  unsafe fn wasmClose<'m>(engine: &mut Engine<'m, Services<Self>>, context: *mut HeapHeader) -> () {
    let mut wasm = engine.services.capabilities.wasm unsafe wasm.close(&mut engine, context) engine.services.capabilities.wasm = wasm
  }
  effect fn hostCall<'r, 'm, 'w>(engine: &mut Engine<'m, Services<Self>>, id: u32, realm: Realm<'r>, argc: i32, argv: Arguments<'w>) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator {
    let api = engine.services.capabilities.hostApi return run api.call(&mut engine, id, realm, argc, argv)
  }
}

/// Whether the program's capabilities include WebAssembly: a constant, for `static if`.
pub static fn hasWasm<C: Composition>() -> bool { return Composition.wasmPresent() }
