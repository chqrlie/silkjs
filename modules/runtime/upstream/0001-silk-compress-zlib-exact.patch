+++ b/corpus/native/deflate-zlib-bytes/main.silk
@@ -0,0 +1,165 @@
+import silk.mem.allocator {Allocator, OutOfMemoryError}
+import silk.core.effect {Effect}
+import silk.compress.deflate {EncodeError, EncodeProgress, EncodeStatus, Encoder, Flush, Options, Strategy}
+import silk.compress.inflate {DecodeError, Decoder, ErrorDetail, Format, Limits, Progress, Status}
+import silk.core.result {Result}
+import silk.collections.slice {Slice}
+import silk.num.usize
+
+// The encoder writes the bytes of zlib 1.3.1, and the decoder reports zlib's causes. The
+// expected bytes are what zlib 1.3.1 wrote for the same input and options (deflate, deflateRaw
+// and gzip of Node's binding over that zlib), with the gzip operating system byte set to 255.
+
+const PLAIN: &'static [u8] = b"\x73\x69\x6c\x6b\x20\x64\x65\x66\x6c\x61\x74\x65\x2c\x20\x73\x69\x6c\x6b\x20\x69\x6e\x66\x6c\x61\x74\x65\x2c\x20\x73\x69\x6c\x6b\x20\x64\x65\x66\x6c\x61\x74\x65\x20\x61\x67\x61\x69\x6e\x20\x61\x6e\x64\x20\x61\x67\x61\x69\x6e\x20\x61\x6e\x64\x20\x61\x67\x61\x69\x6e\x3b\x20\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x20\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39"
+const RUNS: &'static [u8] = b"aaaaaaaaaaaaaaaaaaaaaaaabbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
+
+fn same(left: &[u8], right: &[u8]) -> bool {
+  if left.length != right.length { return false }
+  let mut index: usize = 0
+  while index < left.length {
+    if left[index] != right[index] { return false }
+    index = index + 1
+  }
+  return true
+}
+
+// Encodes `input` through steps of `width` input bytes and `room` output bytes, and compares.
+effect fn writes(input: &[u8], expected: &[u8], format: Format, options: Options, dictionary: &[u8], width: usize, room: usize) -> bool
+! OutOfMemoryError | EncodeError ? &mut Allocator {
+  let mut encoder = run Encoder.make(format, move options)
+  if dictionary.length != 0 {
+    if let Result<(), EncodeError>.Failure {..} = Encoder.setDictionary(&mut encoder, dictionary) { return false }
+  }
+  let mut output: [u8; 512] = [0; 512]
+  let mut consumed: usize = 0
+  let mut written: usize = 0
+  let mut calls: usize = 0
+  while calls < 4096 {
+    calls = calls + 1
+    let mut take = input.length - consumed
+    let mut flush = Flush.Finish
+    if take > width {
+      take = width
+      flush = Flush.None
+    }
+    let mut space = output.length - written
+    if space > room { space = room }
+    let step = Encoder.step(&mut encoder, Slice.view<u8>(input, consumed, take), Slice.viewMut<u8>(&mut output, written, space), flush)
+    match move step {
+      Result<EncodeProgress, EncodeError>.Success {value} => {
+        consumed = consumed + value.consumed
+        written = written + value.written
+        if value.status == EncodeStatus.Finished {
+          return consumed == input.length && same(Slice.view<u8>(&output, 0, written), expected)
+        }
+      }
+      Result<EncodeProgress, EncodeError>.Failure {..} => { return false }
+    }
+  }
+  return false
+}
+
+fn limits() -> Limits {
+  return Limits {maxInputBytes: 4096, maxOutputBytes: 4096, maxMembers: 8, maxHeaderBytes: 64, maxMemoryBytes: 65536}
+}
+
+// Decodes `input` and returns the detail of its failure, or `None` if it decodes.
+effect fn detail(input: &[u8], format: Format, windowBits: u32) -> ErrorDetail ! OutOfMemoryError | DecodeError ? &mut Allocator {
+  let mut decoder = run Decoder.make(format, limits())
+  if windowBits != 255 {
+    if let Result<(), DecodeError>.Failure {..} = Decoder.setWindowBits(&mut decoder, windowBits) { return ErrorDetail.None }
+  }
+  let mut output: [u8; 512] = [0; 512]
+  return match Decoder.step(&mut decoder, input, &mut output, true) {
+    Result<Progress, DecodeError>.Success {..} => ErrorDetail.None
+    Result<Progress, DecodeError>.Failure {..} => Decoder.failureDetail(&decoder)
+  }
+}
+
+effect fn program() -> i32 ! OutOfMemoryError | EncodeError | DecodeError ? &mut Allocator {
+  let raw: &[u8] = b"\x2b\xce\xcc\xc9\x56\x48\x49\x4d\xcb\x49\x2c\x49\xd5\x51\x28\x06\xf1\x32\xf3\x90\x79\x50\x39\x85\xc4\xf4\xc4\xcc\x3c\x85\xc4\xbc\x14\x74\x96\xb5\x82\x81\xa1\x91\xb1\x89\xa9\x99\xb9\x85\x25\x12\x13\x00"
+  let zlib: &[u8] = b"\x78\x01\x2b\xce\xcc\xc9\x56\x48\x49\x4d\xcb\x49\x2c\x49\xd5\x51\x28\x06\xf1\x32\xf3\x90\x79\x50\x39\x85\xc4\xf4\xc4\xcc\x3c\x85\xc4\xbc\x14\x74\x96\xb5\x82\x81\xa1\x91\xb1\x89\xa9\x99\xb9\x85\x25\x12\x13\x00\x74\x19\x1c\x3a"
+  let gzip: &[u8] = b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff\x2b\xce\xcc\xc9\x56\x48\x49\x4d\xcb\x49\x2c\x49\xd5\x51\x28\x06\xf1\x32\xf3\x90\x79\x50\x39\x85\xc4\xf4\xc4\xcc\x3c\x85\xc4\xbc\x14\x74\x96\xb5\x82\x81\xa1\x91\xb1\x89\xa9\x99\xb9\x85\x25\x12\x13\x00\xb0\xa5\xf6\xd5\x59\x00\x00\x00"
+  let stored: &[u8] = b"\x01\x59\x00\xa6\xff\x73\x69\x6c\x6b\x20\x64\x65\x66\x6c\x61\x74\x65\x2c\x20\x73\x69\x6c\x6b\x20\x69\x6e\x66\x6c\x61\x74\x65\x2c\x20\x73\x69\x6c\x6b\x20\x64\x65\x66\x6c\x61\x74\x65\x20\x61\x67\x61\x69\x6e\x20\x61\x6e\x64\x20\x61\x67\x61\x69\x6e\x20\x61\x6e\x64\x20\x61\x67\x61\x69\x6e\x3b\x20\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x20\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39"
+  let preset: &[u8] = b"\x78\xbb\x83\x99\x09\xcc\x2b\x46\x92\xd1\x51\x00\xf3\xa0\x32\x50\x1e\xaa\xae\xc4\xbc\x14\x74\x96\xb5\x82\x81\xa1\x91\xb1\x89\xa9\x99\xb9\x85\x25\x12\x13\x00\x74\x19\x1c\x3a"
+  let rle: &[u8] = b"\x4b\xc4\x01\x92\x08\x02\x00"
+  let fixed: &[u8] = b"\x2b\xce\xcc\xc9\x56\x48\x49\x4d\xcb\x49\x2c\x49\xd5\x51\x28\x06\xf1\x32\xf3\x90\x79\x50\x39\x85\xc4\xf4\xc4\xcc\x3c\x85\xc4\xbc\x14\x74\x96\xb5\x82\x81\xa1\x91\xb1\x89\xa9\x99\xb9\x85\x25\x12\x13\x00"
+  // The same bytes for every way to cut the input and the output into steps.
+  let widths: [usize; 4] = [1, 7, 30, 4096]
+  let rooms: [usize; 4] = [1, 5, 64, 512]
+  let mut index: usize = 0
+  while index < 16 {
+    let width = widths[index / 4]
+    let room = rooms[index % 4]
+    if !run writes(PLAIN, raw, Format.Raw, Options.make(6), b"", width, room) { return 1 }
+    if !run writes(PLAIN, zlib, Format.Zlib, Options.make(1), b"", width, room) { return 2 }
+    if !run writes(PLAIN, gzip, Format.Gzip, Options.make(9), b"", width, room) { return 3 }
+    if !run writes(PLAIN, preset, Format.Zlib, Options.make(6), b"silk deflate again inflate", width, room) { return 4 }
+    if !run writes(RUNS, rle, Format.Raw, Options {level: 6, windowBits: 15, memoryLevel: 8, strategy: Strategy.Rle}, b"", width, room) { return 5 }
+    if !run writes(PLAIN, fixed, Format.Raw, Options {level: 4, windowBits: 15, memoryLevel: 8, strategy: Strategy.Fixed}, b"", width, room) { return 6 }
+    index = index + 1
+  }
+  // Level 0 takes the lengths of its stored blocks from the room in the output, so one case.
+  if !run writes(PLAIN, stored, Format.Raw, Options.make(0), b"", 4096, 512) { return 7 }
+
+  // The gzip operating system byte.
+  let mut encoder = run Encoder.make(Format.Gzip, Options.make(9))
+  Encoder.setGzipSystem(&mut encoder, 3)
+  let mut output: [u8; 512] = [0; 512]
+  match Encoder.step(&mut encoder, PLAIN, &mut output, Flush.Finish) {
+    Result<EncodeProgress, EncodeError>.Success {value} => {
+      if value.status != EncodeStatus.Finished || output[9] != 3 || value.written != gzip.length { return 8 }
+    }
+    Result<EncodeProgress, EncodeError>.Failure {..} => { return 8 }
+  }
+
+  // The causes of failures, as zlib names them.
+  if (run detail(b"\x07", Format.Raw, 255)) != ErrorDetail.BlockType { return 20 }
+  if (run detail(b"\x00\x00\x00\x12\x34", Format.Raw, 255)) != ErrorDetail.StoredLengths { return 21 }
+  if (run detail(b"\xfd\xff\xff", Format.Raw, 255)) != ErrorDetail.SymbolCounts { return 22 }
+  if (run detail(b"\x4b\x04\xfa\x00\x00", Format.Raw, 255)) != ErrorDetail.DistanceTooFar { return 23 }
+  if (run detail(b"\x78\x00", Format.Zlib, 255)) != ErrorDetail.HeaderCheck { return 24 }
+  if (run detail(b"\x77\x09", Format.Zlib, 255)) != ErrorDetail.Method { return 25 }
+  if (run detail(b"\x88\x1c", Format.Zlib, 255)) != ErrorDetail.WindowSize { return 26 }
+  if (run detail(b"\x1f\x8c\x08\x00", Format.Gzip, 255)) != ErrorDetail.HeaderCheck { return 27 }
+  if (run detail(b"\x1f\x8b\x08\xe0", Format.Gzip, 255)) != ErrorDetail.HeaderFlags { return 28 }
+  if (run detail(zlib, Format.Zlib, 255)) != ErrorDetail.None { return 29 }
+  // A zlib header that names a 32 KiB window, read with a smaller one.
+  if (run detail(zlib, Format.Zlib, 9)) != ErrorDetail.WindowSize { return 30 }
+  if (run detail(zlib, Format.Zlib, 15)) != ErrorDetail.None { return 31 }
+  if (run detail(zlib, Format.Zlib, 0)) != ErrorDetail.None { return 32 }
+
+  // A member stop leaves what follows a gzip member unconsumed.
+  let mut decoder = run Decoder.make(Format.Gzip, limits())
+  Decoder.setMemberStop(&mut decoder, true)
+  let mut two: [u8; 256] = [0; 256]
+  Slice.copyInto<u8>(&mut two, 0, gzip)
+  Slice.copyInto<u8>(&mut two, gzip.length, gzip)
+  match Decoder.step(&mut decoder, Slice.view<u8>(&two, 0, gzip.length * 2), &mut output, false) {
+    Result<Progress, DecodeError>.Success {value} => {
+      if value.status != Status.Finished || value.consumed != gzip.length || value.written != PLAIN.length { return 40 }
+    }
+    Result<Progress, DecodeError>.Failure {..} => { return 40 }
+  }
+  // A block stop returns after the header and after each block.
+  let mut stepper = run Decoder.make(Format.Zlib, limits())
+  Decoder.setBlockStop(&mut stepper, true)
+  match Decoder.step(&mut stepper, zlib, &mut output, false) {
+    Result<Progress, DecodeError>.Success {value} => {
+      if value.status != Status.NeedInput || value.consumed != 2 || value.written != 0 { return 41 }
+    }
+    Result<Progress, DecodeError>.Failure {..} => { return 41 }
+  }
+  match Decoder.step(&mut stepper, Slice.view<u8>(zlib, 2, zlib.length - 2), &mut output, false) {
+    Result<Progress, DecodeError>.Success {value} => {
+      if value.status != Status.NeedInput || value.written != PLAIN.length || value.consumed != zlib.length - 6 { return 44 }
+    }
+    Result<Progress, DecodeError>.Failure {..} => { return 43 }
+  }
+  return 42
+}
+
+pub effect fn main() -> i32 ! OutOfMemoryError | EncodeError | DecodeError {
+  let mut allocator = Allocator.systemAllocatorProvider()
+  return run program() |> Effect.provideMut<Allocator>(&mut allocator)
+}
