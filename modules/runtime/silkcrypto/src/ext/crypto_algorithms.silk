//! The operations of the crypto bridge (ext/crypto_silk) over silk.crypto: random bytes,
//! constant-time comparison, PBKDF2, scrypt, HKDF, streaming and one-shot hashes (MD5, SHA-1,
//! SHA-2, SHA-3, SHAKE, BLAKE2, RIPEMD-160, SM3, MD5-SHA1), HMAC, the AES modes (ECB, CBC, CFB,
//! CFB8, CFB1, OFB, CTR, GCM) and ChaCha20 with and without Poly1305, cipher information and the
//! algorithm lists. Results, handles and failures are those of ../openssl's bridge: a failure that
//! OpenSSL reports with an error code carries OpenSSL's error string, so Node's error codes come
//! out the same. Other operations (keys, signatures, key agreement, certificates) fail with
//! ERR_CRYPTO_UNSUPPORTED_OPERATION.
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.collections.slice { Slice }
import silk.system.random { Random }
import silk.system.random_native { OsRandom }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.i32
import silk.num.i64
import silk.num.usize
import silk.crypto.digest { Digest }
import silk.crypto.hmac { Hmac }
import silk.crypto.md5 { Md5 }
import silk.crypto.md5_sha1 { Md5Sha1 }
import silk.crypto.sha1 { Sha1 }
import silk.crypto.sha2 { Sha224, Sha256, Sha384, Sha512, Sha512_224, Sha512_256 }
import silk.crypto.sha3 { Sha3_224, Sha3_256, Sha3_384, Sha3_512, Shake128, Shake256 }
import silk.crypto.blake2b { Blake2b512 }
import silk.crypto.blake2s { Blake2s256 }
import silk.crypto.ripemd160 { Ripemd160 }
import silk.crypto.sm3 { Sm3 }
import silk.crypto.pbkdf2 { Pbkdf2, Pbkdf2Error }
import silk.crypto.hkdf { Hkdf, OutputTooLongError }
import silk.crypto.scrypt { Scrypt, ScryptError }
import silk.crypto.aes { AesCbc, AesEcb, AesCtr, AesCfb, AesCfb8, AesCfb1, AesOfb, AesError }
import silk.crypto.aes_gcm { AesGcmEncryptor, AesGcmDecryptor, AesGcmError }
import silk.crypto.chacha20_poly1305 { ChaCha20, ChaCha20Error, ChaCha20Poly1305Encryptor, ChaCha20Poly1305Decryptor, AeadError }

unsafe extern "C" fn calloc(count: usize, size: usize) -> ?*mut u8
unsafe extern "C" fn realloc(pointer: ?*mut u8, size: usize) -> ?*mut u8
unsafe extern "C" fn free(pointer: ?*mut u8) -> ()

/// One operation: the bridge's Job fields this file reads and writes.
pub struct Call {
  pub op: i32, pub data: [?*mut u8; 8], pub lengths: [usize; 8], pub numbers: [i64; 8], pub handle: ?*mut u8,
  pub output: ?*mut u8, pub length: usize, pub capacity: usize, pub result: i64, pub resultKind: i32,
  pub created: ?*mut u8, pub createdKind: i32, pub error: ?*mut u8, pub codedError: bool,
}

fn nil() -> ?*mut u8 { return Pointer.null<u8>() }
unsafe fn nonnull<T>(p: ?*mut T) -> *mut T { return unsafe Intrinsic.pointerRequalify<?*mut T, *mut T>(p) }
unsafe fn at(p: ?*mut u8, index: usize) -> *mut u8 { return unsafe Pointer.atMut<u8>(unsafe Pointer.assumeManyMut<u8>(unsafe nonnull(p)), index) }
const EMPTY: [u8; 1] = [0]
/// The bytes of argument `i` (empty when it was not given).
unsafe fn arg<'a>(anchor: &'a (), c: &Call, i: usize) -> &'a [u8] {
  if c.lengths[i] == 0 || Pointer.isNull<u8>(c.data[i]) { return Slice.view<u8>(&EMPTY, 0, 0) }
  return unsafe Pointer.borrowMany<(), u8>(anchor, unsafe Pointer.assumeMany<u8>(unsafe Intrinsic.pointerRequalify<?*mut u8, *const u8>(c.data[i])), c.lengths[i])
}
unsafe fn writable<'a>(anchor: &'a mut (), p: ?*mut u8, length: usize) -> &'a mut [u8] {
  return unsafe Pointer.borrowManyMut<(), u8>(move anchor, unsafe Pointer.assumeManyMut<u8>(unsafe nonnull(p)), length)
}
/// Zeroes `length` bytes at `p` (a null `p` is nothing).
pub unsafe fn cleanse(p: ?*mut u8, length: usize) -> () {
  if Pointer.isNull<u8>(p) { return () }
  let mut i: usize = 0
  while i < length { unsafe Pointer.put<u8>(unsafe at(p, i), 0) i = i + 1 }
}
// Output room for `n` bytes (the result is `n` bytes unless changed).
unsafe fn reserve(c: &mut Call, n: usize) -> bool {
  let capacity = if n == 0 { 1 } else { n }
  unsafe free(c.output)
  c.output = unsafe calloc(1, capacity) c.capacity = capacity c.length = n
  return !Pointer.isNull<u8>(c.output)
}
unsafe fn outputSlice<'a>(anchor: &'a mut (), c: &Call) -> &'a mut [u8] { return unsafe writable(move anchor, c.output, c.capacity) }
// A failure with OpenSSL's error string (Node derives the code from it).
unsafe fn failWith(c: &mut Call, text: &[u8]) -> bool {
  unsafe setError(&mut c.*, text) c.codedError = false
  return false
}
// A failure with Node's code (`ERR_...: message`).
unsafe fn refuse(c: &mut Call, text: &[u8]) -> bool {
  unsafe setError(&mut c.*, text) c.codedError = true
  return false
}
unsafe fn setError(c: &mut Call, text: &[u8]) -> () {
  let n = if text.length > 255 { 255 } else { text.length }
  let mut i: usize = 0
  while i < n { unsafe Pointer.put<u8>(unsafe at(c.error, i), text[i]) i = i + 1 }
  unsafe Pointer.put<u8>(unsafe at(c.error, n), 0)
}
fn lower(b: u8) -> u8 { return if b >= 65 && b <= 90 { b + 32 } else { b } }
fn same(name: &[u8], text: &[u8]) -> bool {
  if name.length != text.length { return false }
  let mut i: usize = 0
  while i < name.length { if lower(name[i]) != text[i] { return false } i = i + 1 }
  return true
}
fn endsWithNull(name: &[u8]) -> usize { if name.length > 0 && name[name.length - 1] == 0 { return name.length - 1 } return name.length }

// Digests: a code per algorithm, and a state that holds any of them.
const H_MD5: i32 = 1
const H_SHA1: i32 = 2
const H_SHA224: i32 = 3
const H_SHA256: i32 = 4
const H_SHA384: i32 = 5
const H_SHA512: i32 = 6
const H_SHA512_224: i32 = 7
const H_SHA512_256: i32 = 8
const H_SHA3_224: i32 = 9
const H_SHA3_256: i32 = 10
const H_SHA3_384: i32 = 11
const H_SHA3_512: i32 = 12
const H_SHAKE128: i32 = 13
const H_SHAKE256: i32 = 14
const H_BLAKE2B512: i32 = 15
const H_BLAKE2S256: i32 = 16
const H_RIPEMD160: i32 = 17
const H_SM3: i32 = 18
const H_MD5_SHA1: i32 = 19

/// The digest a name means, as OpenSSL resolves names Node passes: case-insensitive, with the
/// RSA- signature aliases, dss1, the SHA2- and SHA- spellings and RIPEMD's aliases. 0 is none.
fn digestCode(raw: &[u8]) -> i32 {
  let mut name = Slice.view<u8>(raw, 0, endsWithNull(raw))
  if name.length > 4 && same(Slice.view<u8>(name, 0, 4), b"rsa-") { name = Slice.view<u8>(name, 4, name.length - 4) }
  if same(name, b"md5") { return H_MD5 }
  if same(name, b"sha1") || same(name, b"sha-1") || same(name, b"dss1") { return H_SHA1 }
  if same(name, b"sha224") || same(name, b"sha2-224") || same(name, b"sha-224") { return H_SHA224 }
  if same(name, b"sha256") || same(name, b"sha2-256") || same(name, b"sha-256") { return H_SHA256 }
  if same(name, b"sha384") || same(name, b"sha2-384") || same(name, b"sha-384") { return H_SHA384 }
  if same(name, b"sha512") || same(name, b"sha2-512") || same(name, b"sha-512") { return H_SHA512 }
  if same(name, b"sha512-224") || same(name, b"sha2-512/224") || same(name, b"sha-512/224") { return H_SHA512_224 }
  if same(name, b"sha512-256") || same(name, b"sha2-512/256") || same(name, b"sha-512/256") { return H_SHA512_256 }
  if same(name, b"sha3-224") { return H_SHA3_224 }
  if same(name, b"sha3-256") { return H_SHA3_256 }
  if same(name, b"sha3-384") { return H_SHA3_384 }
  if same(name, b"sha3-512") { return H_SHA3_512 }
  if same(name, b"shake128") || same(name, b"shake-128") { return H_SHAKE128 }
  if same(name, b"shake256") || same(name, b"shake-256") { return H_SHAKE256 }
  if same(name, b"blake2b512") { return H_BLAKE2B512 }
  if same(name, b"blake2s256") { return H_BLAKE2S256 }
  if same(name, b"ripemd160") || same(name, b"ripemd-160") || same(name, b"ripemd") || same(name, b"rmd160") { return H_RIPEMD160 }
  if same(name, b"sm3") { return H_SM3 }
  if same(name, b"md5-sha1") { return H_MD5_SHA1 }
  return 0
}
/// The digest's output length (the default for SHAKE, as OpenSSL's EVP_MD_get_size).
fn digestSize(code: i32) -> usize {
  if code == H_MD5 { return 16 }
  if code == H_SHA1 || code == H_RIPEMD160 { return 20 }
  if code == H_SHA224 || code == H_SHA512_224 || code == H_SHA3_224 { return 28 }
  if code == H_SHA256 || code == H_SHA512_256 || code == H_SHA3_256 || code == H_BLAKE2S256 || code == H_SM3 || code == H_SHAKE256 { return 32 }
  if code == H_SHA384 || code == H_SHA3_384 { return 48 }
  if code == H_SHAKE128 { return 16 }
  if code == H_MD5_SHA1 { return 36 }
  return 64
}
fn isXof(code: i32) -> bool { return code == H_SHAKE128 || code == H_SHAKE256 }

union HashState {
  Md5 { v: Md5 }, Sha1 { v: Sha1 }, Sha224 { v: Sha224 }, Sha256 { v: Sha256 }, Sha384 { v: Sha384 }, Sha512 { v: Sha512 },
  Sha512_224 { v: Sha512_224 }, Sha512_256 { v: Sha512_256 }, Sha3_224 { v: Sha3_224 }, Sha3_256 { v: Sha3_256 },
  Sha3_384 { v: Sha3_384 }, Sha3_512 { v: Sha3_512 }, Shake128 { v: Shake128 }, Shake256 { v: Shake256 },
  Blake2b512 { v: Blake2b512 }, Blake2s256 { v: Blake2s256 }, Ripemd160 { v: Ripemd160 }, Sm3 { v: Sm3 }, Md5Sha1 { v: Md5Sha1 },
}
struct HashContext { code: i32, state: HashState }
fn hashMake(code: i32) -> HashState {
  if code == H_MD5 { return HashState.Md5 { v: Md5.make() } }
  if code == H_SHA1 { return HashState.Sha1 { v: Sha1.make() } }
  if code == H_SHA224 { return HashState.Sha224 { v: Sha224.make() } }
  if code == H_SHA256 { return HashState.Sha256 { v: Sha256.make() } }
  if code == H_SHA384 { return HashState.Sha384 { v: Sha384.make() } }
  if code == H_SHA512_224 { return HashState.Sha512_224 { v: Sha512_224.make() } }
  if code == H_SHA512_256 { return HashState.Sha512_256 { v: Sha512_256.make() } }
  if code == H_SHA3_224 { return HashState.Sha3_224 { v: Sha3_224.make() } }
  if code == H_SHA3_256 { return HashState.Sha3_256 { v: Sha3_256.make() } }
  if code == H_SHA3_384 { return HashState.Sha3_384 { v: Sha3_384.make() } }
  if code == H_SHA3_512 { return HashState.Sha3_512 { v: Sha3_512.make() } }
  if code == H_SHAKE128 { return HashState.Shake128 { v: Shake128.make() } }
  if code == H_SHAKE256 { return HashState.Shake256 { v: Shake256.make() } }
  if code == H_BLAKE2B512 { return HashState.Blake2b512 { v: Blake2b512.make() } }
  if code == H_BLAKE2S256 { return HashState.Blake2s256 { v: Blake2s256.make() } }
  if code == H_RIPEMD160 { return HashState.Ripemd160 { v: Ripemd160.make() } }
  if code == H_SM3 { return HashState.Sm3 { v: Sm3.make() } }
  if code == H_MD5_SHA1 { return HashState.Md5Sha1 { v: Md5Sha1.make() } }
  return HashState.Sha512 { v: Sha512.make() }
}
fn hashUpdate(state: &mut HashState, bytes: &[u8]) -> () {
  match &mut state.* {
    HashState.Md5 { v } => v.update(bytes) HashState.Sha1 { v } => v.update(bytes) HashState.Sha224 { v } => v.update(bytes)
    HashState.Sha256 { v } => v.update(bytes) HashState.Sha384 { v } => v.update(bytes) HashState.Sha512 { v } => v.update(bytes)
    HashState.Sha512_224 { v } => v.update(bytes) HashState.Sha512_256 { v } => v.update(bytes) HashState.Sha3_224 { v } => v.update(bytes)
    HashState.Sha3_256 { v } => v.update(bytes) HashState.Sha3_384 { v } => v.update(bytes) HashState.Sha3_512 { v } => v.update(bytes)
    HashState.Shake128 { v } => v.update(bytes) HashState.Shake256 { v } => v.update(bytes) HashState.Blake2b512 { v } => v.update(bytes)
    HashState.Blake2s256 { v } => v.update(bytes) HashState.Ripemd160 { v } => v.update(bytes) HashState.Sm3 { v } => v.update(bytes)
    HashState.Md5Sha1 { v } => v.update(bytes)
  }
}
fn hashCopy(state: &HashState) -> HashState {
  return match &state.* {
    HashState.Md5 { v } => HashState.Md5 { v: v.copy() } HashState.Sha1 { v } => HashState.Sha1 { v: v.copy() }
    HashState.Sha224 { v } => HashState.Sha224 { v: v.copy() } HashState.Sha256 { v } => HashState.Sha256 { v: v.copy() }
    HashState.Sha384 { v } => HashState.Sha384 { v: v.copy() } HashState.Sha512 { v } => HashState.Sha512 { v: v.copy() }
    HashState.Sha512_224 { v } => HashState.Sha512_224 { v: v.copy() } HashState.Sha512_256 { v } => HashState.Sha512_256 { v: v.copy() }
    HashState.Sha3_224 { v } => HashState.Sha3_224 { v: v.copy() } HashState.Sha3_256 { v } => HashState.Sha3_256 { v: v.copy() }
    HashState.Sha3_384 { v } => HashState.Sha3_384 { v: v.copy() } HashState.Sha3_512 { v } => HashState.Sha3_512 { v: v.copy() }
    HashState.Shake128 { v } => HashState.Shake128 { v: v.copy() } HashState.Shake256 { v } => HashState.Shake256 { v: v.copy() }
    HashState.Blake2b512 { v } => HashState.Blake2b512 { v: v.copy() } HashState.Blake2s256 { v } => HashState.Blake2s256 { v: v.copy() }
    HashState.Ripemd160 { v } => HashState.Ripemd160 { v: v.copy() } HashState.Sm3 { v } => HashState.Sm3 { v: v.copy() }
    HashState.Md5Sha1 { v } => HashState.Md5Sha1 { v: v.copy() }
  }
}
/// Writes the digest (all of `output` for SHAKE) and consumes the state.
fn hashFinish(state: HashState, output: &mut [u8]) -> () {
  match move state {
    HashState.Md5 { v } => v.finishInto(move output) HashState.Sha1 { v } => v.finishInto(move output) HashState.Sha224 { v } => v.finishInto(move output)
    HashState.Sha256 { v } => v.finishInto(move output) HashState.Sha384 { v } => v.finishInto(move output) HashState.Sha512 { v } => v.finishInto(move output)
    HashState.Sha512_224 { v } => v.finishInto(move output) HashState.Sha512_256 { v } => v.finishInto(move output) HashState.Sha3_224 { v } => v.finishInto(move output)
    HashState.Sha3_256 { v } => v.finishInto(move output) HashState.Sha3_384 { v } => v.finishInto(move output) HashState.Sha3_512 { v } => v.finishInto(move output)
    HashState.Shake128 { v } => v.finishInto(move output) HashState.Shake256 { v } => v.finishInto(move output) HashState.Blake2b512 { v } => v.finishInto(move output)
    HashState.Blake2s256 { v } => v.finishInto(move output) HashState.Ripemd160 { v } => v.finishInto(move output) HashState.Sm3 { v } => v.finishInto(move output)
    HashState.Md5Sha1 { v } => v.finishInto(move output)
  }
}

union HmacState {
  Md5 { v: Hmac<Md5> }, Sha1 { v: Hmac<Sha1> }, Sha224 { v: Hmac<Sha224> }, Sha256 { v: Hmac<Sha256> }, Sha384 { v: Hmac<Sha384> },
  Sha512 { v: Hmac<Sha512> }, Sha512_224 { v: Hmac<Sha512_224> }, Sha512_256 { v: Hmac<Sha512_256> }, Sha3_224 { v: Hmac<Sha3_224> },
  Sha3_256 { v: Hmac<Sha3_256> }, Sha3_384 { v: Hmac<Sha3_384> }, Sha3_512 { v: Hmac<Sha3_512> }, Blake2b512 { v: Hmac<Blake2b512> },
  Blake2s256 { v: Hmac<Blake2s256> }, Ripemd160 { v: Hmac<Ripemd160> }, Sm3 { v: Hmac<Sm3> }, Md5Sha1 { v: Hmac<Md5Sha1> },
}
struct HmacContext { code: i32, state: HmacState }
fn hmacMake(code: i32, key: &[u8]) -> HmacState {
  if code == H_MD5 { return HmacState.Md5 { v: Hmac<Md5>.make(key) } }
  if code == H_SHA1 { return HmacState.Sha1 { v: Hmac<Sha1>.make(key) } }
  if code == H_SHA224 { return HmacState.Sha224 { v: Hmac<Sha224>.make(key) } }
  if code == H_SHA256 { return HmacState.Sha256 { v: Hmac<Sha256>.make(key) } }
  if code == H_SHA384 { return HmacState.Sha384 { v: Hmac<Sha384>.make(key) } }
  if code == H_SHA512_224 { return HmacState.Sha512_224 { v: Hmac<Sha512_224>.make(key) } }
  if code == H_SHA512_256 { return HmacState.Sha512_256 { v: Hmac<Sha512_256>.make(key) } }
  if code == H_SHA3_224 { return HmacState.Sha3_224 { v: Hmac<Sha3_224>.make(key) } }
  if code == H_SHA3_256 { return HmacState.Sha3_256 { v: Hmac<Sha3_256>.make(key) } }
  if code == H_SHA3_384 { return HmacState.Sha3_384 { v: Hmac<Sha3_384>.make(key) } }
  if code == H_SHA3_512 { return HmacState.Sha3_512 { v: Hmac<Sha3_512>.make(key) } }
  if code == H_BLAKE2B512 { return HmacState.Blake2b512 { v: Hmac<Blake2b512>.make(key) } }
  if code == H_BLAKE2S256 { return HmacState.Blake2s256 { v: Hmac<Blake2s256>.make(key) } }
  if code == H_RIPEMD160 { return HmacState.Ripemd160 { v: Hmac<Ripemd160>.make(key) } }
  if code == H_SM3 { return HmacState.Sm3 { v: Hmac<Sm3>.make(key) } }
  if code == H_MD5_SHA1 { return HmacState.Md5Sha1 { v: Hmac<Md5Sha1>.make(key) } }
  return HmacState.Sha512 { v: Hmac<Sha512>.make(key) }
}
fn hmacUpdate(state: &mut HmacState, bytes: &[u8]) -> () {
  match &mut state.* {
    HmacState.Md5 { v } => v.update(bytes) HmacState.Sha1 { v } => v.update(bytes) HmacState.Sha224 { v } => v.update(bytes)
    HmacState.Sha256 { v } => v.update(bytes) HmacState.Sha384 { v } => v.update(bytes) HmacState.Sha512 { v } => v.update(bytes)
    HmacState.Sha512_224 { v } => v.update(bytes) HmacState.Sha512_256 { v } => v.update(bytes) HmacState.Sha3_224 { v } => v.update(bytes)
    HmacState.Sha3_256 { v } => v.update(bytes) HmacState.Sha3_384 { v } => v.update(bytes) HmacState.Sha3_512 { v } => v.update(bytes)
    HmacState.Blake2b512 { v } => v.update(bytes) HmacState.Blake2s256 { v } => v.update(bytes) HmacState.Ripemd160 { v } => v.update(bytes)
    HmacState.Sm3 { v } => v.update(bytes) HmacState.Md5Sha1 { v } => v.update(bytes)
  }
}
fn hmacFinish(state: HmacState, output: &mut [u8]) -> () {
  match move state {
    HmacState.Md5 { v } => v.finishInto(move output) HmacState.Sha1 { v } => v.finishInto(move output) HmacState.Sha224 { v } => v.finishInto(move output)
    HmacState.Sha256 { v } => v.finishInto(move output) HmacState.Sha384 { v } => v.finishInto(move output) HmacState.Sha512 { v } => v.finishInto(move output)
    HmacState.Sha512_224 { v } => v.finishInto(move output) HmacState.Sha512_256 { v } => v.finishInto(move output) HmacState.Sha3_224 { v } => v.finishInto(move output)
    HmacState.Sha3_256 { v } => v.finishInto(move output) HmacState.Sha3_384 { v } => v.finishInto(move output) HmacState.Sha3_512 { v } => v.finishInto(move output)
    HmacState.Blake2b512 { v } => v.finishInto(move output) HmacState.Blake2s256 { v } => v.finishInto(move output) HmacState.Ripemd160 { v } => v.finishInto(move output)
    HmacState.Sm3 { v } => v.finishInto(move output) HmacState.Md5Sha1 { v } => v.finishInto(move output)
  }
}
fn pbkdf2With(code: i32, password: &[u8], salt: &[u8], iterations: u32, output: &mut [u8]) -> bool {
  let result = if code == H_MD5 { Pbkdf2.derive<Md5>(password, salt, iterations, move output) }
    else if code == H_SHA1 { Pbkdf2.derive<Sha1>(password, salt, iterations, move output) }
    else if code == H_SHA224 { Pbkdf2.derive<Sha224>(password, salt, iterations, move output) }
    else if code == H_SHA256 { Pbkdf2.derive<Sha256>(password, salt, iterations, move output) }
    else if code == H_SHA384 { Pbkdf2.derive<Sha384>(password, salt, iterations, move output) }
    else if code == H_SHA512 { Pbkdf2.derive<Sha512>(password, salt, iterations, move output) }
    else if code == H_SHA512_224 { Pbkdf2.derive<Sha512_224>(password, salt, iterations, move output) }
    else if code == H_SHA512_256 { Pbkdf2.derive<Sha512_256>(password, salt, iterations, move output) }
    else if code == H_SHA3_224 { Pbkdf2.derive<Sha3_224>(password, salt, iterations, move output) }
    else if code == H_SHA3_256 { Pbkdf2.derive<Sha3_256>(password, salt, iterations, move output) }
    else if code == H_SHA3_384 { Pbkdf2.derive<Sha3_384>(password, salt, iterations, move output) }
    else if code == H_SHA3_512 { Pbkdf2.derive<Sha3_512>(password, salt, iterations, move output) }
    else if code == H_BLAKE2B512 { Pbkdf2.derive<Blake2b512>(password, salt, iterations, move output) }
    else if code == H_BLAKE2S256 { Pbkdf2.derive<Blake2s256>(password, salt, iterations, move output) }
    else if code == H_RIPEMD160 { Pbkdf2.derive<Ripemd160>(password, salt, iterations, move output) }
    else if code == H_SM3 { Pbkdf2.derive<Sm3>(password, salt, iterations, move output) }
    else { Pbkdf2.derive<Md5Sha1>(password, salt, iterations, move output) }
  return match move result { Result<(), Pbkdf2Error>.Success { .. } => true Result<(), Pbkdf2Error>.Failure { .. } => false }
}
fn hkdfWith(code: i32, salt: &[u8], key: &[u8], info: &[u8], output: &mut [u8]) -> bool {
  let result = if code == H_MD5 { Hkdf.derive<Md5>(salt, key, info, move output) }
    else if code == H_SHA1 { Hkdf.derive<Sha1>(salt, key, info, move output) }
    else if code == H_SHA224 { Hkdf.derive<Sha224>(salt, key, info, move output) }
    else if code == H_SHA256 { Hkdf.derive<Sha256>(salt, key, info, move output) }
    else if code == H_SHA384 { Hkdf.derive<Sha384>(salt, key, info, move output) }
    else if code == H_SHA512 { Hkdf.derive<Sha512>(salt, key, info, move output) }
    else if code == H_SHA512_224 { Hkdf.derive<Sha512_224>(salt, key, info, move output) }
    else if code == H_SHA512_256 { Hkdf.derive<Sha512_256>(salt, key, info, move output) }
    else if code == H_SHA3_224 { Hkdf.derive<Sha3_224>(salt, key, info, move output) }
    else if code == H_SHA3_256 { Hkdf.derive<Sha3_256>(salt, key, info, move output) }
    else if code == H_SHA3_384 { Hkdf.derive<Sha3_384>(salt, key, info, move output) }
    else if code == H_SHA3_512 { Hkdf.derive<Sha3_512>(salt, key, info, move output) }
    else if code == H_BLAKE2B512 { Hkdf.derive<Blake2b512>(salt, key, info, move output) }
    else if code == H_BLAKE2S256 { Hkdf.derive<Blake2s256>(salt, key, info, move output) }
    else if code == H_RIPEMD160 { Hkdf.derive<Ripemd160>(salt, key, info, move output) }
    else if code == H_SM3 { Hkdf.derive<Sm3>(salt, key, info, move output) }
    else { Hkdf.derive<Md5Sha1>(salt, key, info, move output) }
  return match move result { Result<(), OutputTooLongError>.Success { .. } => true Result<(), OutputTooLongError>.Failure { .. } => false }
}

// Ciphers: a table of what the bridge can run, and a context that holds any of them.
const C_ECB: i32 = 1
const C_CBC: i32 = 2
const C_CFB: i32 = 3
const C_CFB8: i32 = 4
const C_CFB1: i32 = 5
const C_OFB: i32 = 6
const C_CTR: i32 = 7
const C_GCM: i32 = 8
const C_CHACHA_POLY: i32 = 9
const C_CHACHA: i32 = 10
impl Copy for CipherInfo {}
struct CipherInfo { kind: i32, mode: i32, nid: i32, keyLength: i32, ivLength: i32, blockSize: i32, name: &'static [u8] }
fn noCipher() -> CipherInfo { return CipherInfo { kind: 0, mode: 0, nid: 0, keyLength: 0, ivLength: 0, blockSize: 0, name: b"" } }
fn aesInfo(kind: i32, bits: i32) -> CipherInfo {
  let key = bits / 8
  let index = if bits == 128 { 0 } else if bits == 192 { 1 } else { 2 }
  if kind == C_ECB { return CipherInfo { kind: kind, mode: 1, nid: 418 + index * 4, keyLength: key, ivLength: 0, blockSize: 16, name: if index == 0 { b"AES-128-ECB" } else if index == 1 { b"AES-192-ECB" } else { b"AES-256-ECB" } } }
  if kind == C_CBC { return CipherInfo { kind: kind, mode: 2, nid: 419 + index * 4, keyLength: key, ivLength: 16, blockSize: 16, name: if index == 0 { b"AES-128-CBC" } else if index == 1 { b"AES-192-CBC" } else { b"AES-256-CBC" } } }
  if kind == C_OFB { return CipherInfo { kind: kind, mode: 4, nid: 420 + index * 4, keyLength: key, ivLength: 16, blockSize: 1, name: if index == 0 { b"AES-128-OFB" } else if index == 1 { b"AES-192-OFB" } else { b"AES-256-OFB" } } }
  if kind == C_CFB { return CipherInfo { kind: kind, mode: 3, nid: 421 + index * 4, keyLength: key, ivLength: 16, blockSize: 1, name: if index == 0 { b"AES-128-CFB" } else if index == 1 { b"AES-192-CFB" } else { b"AES-256-CFB" } } }
  if kind == C_CFB1 { return CipherInfo { kind: kind, mode: 3, nid: 650 + index, keyLength: key, ivLength: 16, blockSize: 1, name: if index == 0 { b"AES-128-CFB1" } else if index == 1 { b"AES-192-CFB1" } else { b"AES-256-CFB1" } } }
  if kind == C_CFB8 { return CipherInfo { kind: kind, mode: 3, nid: 653 + index, keyLength: key, ivLength: 16, blockSize: 1, name: if index == 0 { b"AES-128-CFB8" } else if index == 1 { b"AES-192-CFB8" } else { b"AES-256-CFB8" } } }
  if kind == C_CTR { return CipherInfo { kind: kind, mode: 5, nid: 904 + index, keyLength: key, ivLength: 16, blockSize: 1, name: if index == 0 { b"AES-128-CTR" } else if index == 1 { b"AES-192-CTR" } else { b"AES-256-CTR" } } }
  return CipherInfo { kind: C_GCM, mode: 6, nid: 895 + index * 3, keyLength: key, ivLength: 12, blockSize: 1, name: if index == 0 { b"id-aes128-GCM" } else if index == 1 { b"id-aes192-GCM" } else { b"id-aes256-GCM" } }
}
const MODES: [&[u8]; 8] = [b"ecb", b"cbc", b"cfb", b"cfb8", b"cfb1", b"ofb", b"ctr", b"gcm"]
const MODE_KINDS: [i32; 8] = [1, 2, 3, 4, 5, 6, 7, 8]
const BITS: [i32; 3] = [128, 192, 256]
/// The cipher a name means (case-insensitive, with OpenSSL's aes128-style and id-aes aliases).
fn cipherByName(raw: &[u8]) -> CipherInfo {
  let name = Slice.view<u8>(raw, 0, endsWithNull(raw))
  if same(name, b"chacha20-poly1305") { return CipherInfo { kind: C_CHACHA_POLY, mode: 0, nid: 1018, keyLength: 32, ivLength: 12, blockSize: 1, name: b"ChaCha20-Poly1305" } }
  if same(name, b"chacha20") { return CipherInfo { kind: C_CHACHA, mode: 0, nid: 1019, keyLength: 32, ivLength: 16, blockSize: 1, name: b"ChaCha20" } }
  if same(name, b"aes128") { return aesInfo(C_CBC, 128) }
  if same(name, b"aes192") { return aesInfo(C_CBC, 192) }
  if same(name, b"aes256") { return aesInfo(C_CBC, 256) }
  let mut b: usize = 0
  while b < 3 {
    let bits = BITS[b]
    let digits: &[u8] = if b == 0 { b"128" } else if b == 1 { b"192" } else { b"256" }
    let mut m: usize = 0
    while m < 8 {
      // aes-<bits>-<mode>, and id-aes<bits>-gcm.
      let mode = MODES[m]
      if name.length == 8 + mode.length && same(Slice.view<u8>(name, 0, 4), b"aes-") && same(Slice.view<u8>(name, 4, 3), digits) && name[7] == 45 && same(Slice.view<u8>(name, 8, mode.length), mode) { return aesInfo(MODE_KINDS[m], bits) }
      m = m + 1
    }
    if name.length == 13 && same(Slice.view<u8>(name, 0, 6), b"id-aes") && same(Slice.view<u8>(name, 6, 3), digits) && same(Slice.view<u8>(name, 9, 4), b"-gcm") { return aesInfo(C_GCM, bits) }
    b = b + 1
  }
  return noCipher()
}
fn cipherByNid(nid: i32) -> CipherInfo {
  if nid == 1018 { return cipherByName(b"chacha20-poly1305") }
  if nid == 1019 { return cipherByName(b"chacha20") }
  let mut b: usize = 0
  while b < 3 {
    let mut m: usize = 0
    while m < 8 { let info = aesInfo(MODE_KINDS[m], BITS[b]) if info.nid == nid { return info } m = m + 1 }
    b = b + 1
  }
  return noCipher()
}

union CipherState {
  Pending, Done, Ecb { v: AesEcb }, Cbc { v: AesCbc }, Cfb { v: AesCfb }, Cfb8 { v: AesCfb8 }, Cfb1 { v: AesCfb1 }, Ofb { v: AesOfb },
  Ctr { v: AesCtr }, GcmSeal { v: AesGcmEncryptor }, GcmOpen { v: AesGcmDecryptor }, PolySeal { v: ChaCha20Poly1305Encryptor },
  PolyOpen { v: ChaCha20Poly1305Decryptor }, Stream { v: ChaCha20 },
}
struct CipherContext {
  kind: i32, encrypt: bool, padding: bool, key: [u8; 32], keyLength: usize, iv: ?*mut u8, ivLength: usize,
  aad: ?*mut u8, aadLength: usize, tag: [u8; 16], tagLength: usize, authTagLength: usize, state: CipherState,
}
fn aesFailed(result: Result<usize, AesError>, n: &mut usize) -> bool {
  return match move result { Result<usize, AesError>.Success { value } => { n.* = value false } Result<usize, AesError>.Failure { .. } => true }
}
fn aesApplyFailed(result: Result<(), AesError>) -> bool { return match move result { Result<(), AesError>.Success { .. } => false Result<(), AesError>.Failure { .. } => true } }
fn gcmFailed(result: Result<(), AesGcmError>) -> bool { return match move result { Result<(), AesGcmError>.Success { .. } => false Result<(), AesGcmError>.Failure { .. } => true } }
fn aeadFailed(result: Result<(), AeadError>) -> bool { return match move result { Result<(), AeadError>.Success { .. } => false Result<(), AeadError>.Failure { .. } => true } }
unsafe fn ctxIv<'a>(anchor: &'a (), x: &CipherContext) -> &'a [u8] {
  if x.ivLength == 0 { return Slice.view<u8>(&EMPTY, 0, 0) }
  return unsafe Pointer.borrowMany<(), u8>(anchor, unsafe Pointer.assumeMany<u8>(unsafe Intrinsic.pointerRequalify<?*mut u8, *const u8>(x.iv)), x.ivLength)
}
unsafe fn ctxAad<'a>(anchor: &'a (), x: &CipherContext) -> &'a [u8] {
  if x.aadLength == 0 { return Slice.view<u8>(&EMPTY, 0, 0) }
  return unsafe Pointer.borrowMany<(), u8>(anchor, unsafe Pointer.assumeMany<u8>(unsafe Intrinsic.pointerRequalify<?*mut u8, *const u8>(x.aad)), x.aadLength)
}
// Makes the cipher once the padding and the additional data are known: at the first update or final.
unsafe fn start(x: &mut CipherContext) -> bool {
  match &x.state { CipherState.Pending => () _ => { return true } }
  let anchor = ()
  let key = Slice.view<u8>(&x.key, 0, x.keyLength)
  let iv = unsafe ctxIv(&anchor, &x.*)
  let aad = unsafe ctxAad(&anchor, &x.*)
  let k = x.kind
  if k == C_ECB {
    let made = if x.encrypt { AesEcb.encryptor(key, x.padding) } else { AesEcb.decryptor(key, x.padding) }
    match move made { Result<AesEcb, AesError>.Success { value } => { x.state = CipherState.Ecb { v: move value } return true } Result<AesEcb, AesError>.Failure { .. } => { return false } }
  }
  if k == C_CBC {
    let made = if x.encrypt { AesCbc.encryptor(key, iv, x.padding) } else { AesCbc.decryptor(key, iv, x.padding) }
    match move made { Result<AesCbc, AesError>.Success { value } => { x.state = CipherState.Cbc { v: move value } return true } Result<AesCbc, AesError>.Failure { .. } => { return false } }
  }
  if k == C_CFB {
    let made = if x.encrypt { AesCfb.encryptor(key, iv) } else { AesCfb.decryptor(key, iv) }
    match move made { Result<AesCfb, AesError>.Success { value } => { x.state = CipherState.Cfb { v: move value } return true } Result<AesCfb, AesError>.Failure { .. } => { return false } }
  }
  if k == C_CFB8 {
    let made = if x.encrypt { AesCfb8.encryptor(key, iv) } else { AesCfb8.decryptor(key, iv) }
    match move made { Result<AesCfb8, AesError>.Success { value } => { x.state = CipherState.Cfb8 { v: move value } return true } Result<AesCfb8, AesError>.Failure { .. } => { return false } }
  }
  if k == C_CFB1 {
    let made = if x.encrypt { AesCfb1.encryptor(key, iv) } else { AesCfb1.decryptor(key, iv) }
    match move made { Result<AesCfb1, AesError>.Success { value } => { x.state = CipherState.Cfb1 { v: move value } return true } Result<AesCfb1, AesError>.Failure { .. } => { return false } }
  }
  if k == C_OFB {
    match move AesOfb.make(key, iv) { Result<AesOfb, AesError>.Success { value } => { x.state = CipherState.Ofb { v: move value } return true } Result<AesOfb, AesError>.Failure { .. } => { return false } }
  }
  if k == C_CTR {
    match move AesCtr.make(key, iv) { Result<AesCtr, AesError>.Success { value } => { x.state = CipherState.Ctr { v: move value } return true } Result<AesCtr, AesError>.Failure { .. } => { return false } }
  }
  if k == C_GCM {
    if x.encrypt {
      match move AesGcmEncryptor.make(key, iv, aad) { Result<AesGcmEncryptor, AesGcmError>.Success { value } => { x.state = CipherState.GcmSeal { v: move value } return true } Result<AesGcmEncryptor, AesGcmError>.Failure { .. } => { return false } }
    }
    match move AesGcmDecryptor.make(key, iv, aad) { Result<AesGcmDecryptor, AesGcmError>.Success { value } => { x.state = CipherState.GcmOpen { v: move value } return true } Result<AesGcmDecryptor, AesGcmError>.Failure { .. } => { return false } }
  }
  if k == C_CHACHA_POLY {
    // A shorter nonce is left-padded with zeros, as OpenSSL does.
    let mut nonce: [u8; 12] = [0; 12]
    let mut i: usize = 0
    while i < iv.length { nonce[12 - iv.length + i] = iv[i] i = i + 1 }
    if x.encrypt {
      match move ChaCha20Poly1305Encryptor.make(key, &nonce, aad) { Result<ChaCha20Poly1305Encryptor, AeadError>.Success { value } => { x.state = CipherState.PolySeal { v: move value } return true } Result<ChaCha20Poly1305Encryptor, AeadError>.Failure { .. } => { return false } }
    }
    match move ChaCha20Poly1305Decryptor.make(key, &nonce, aad) { Result<ChaCha20Poly1305Decryptor, AeadError>.Success { value } => { x.state = CipherState.PolyOpen { v: move value } return true } Result<ChaCha20Poly1305Decryptor, AeadError>.Failure { .. } => { return false } }
  }
  // OpenSSL's ChaCha20 IV: a 32-bit little-endian counter, then the 96-bit nonce.
  if iv.length != 16 { return false }
  let counter = u32.bitOr(u32.bitOr(u8.toU32(iv[0]), u32.shiftLeft(u8.toU32(iv[1]), 8)), u32.bitOr(u32.shiftLeft(u8.toU32(iv[2]), 16), u32.shiftLeft(u8.toU32(iv[3]), 24)))
  match move ChaCha20.make(key, Slice.view<u8>(iv, 4, 12), counter) { Result<ChaCha20, ChaCha20Error>.Success { value } => { x.state = CipherState.Stream { v: move value } return true } Result<ChaCha20, ChaCha20Error>.Failure { .. } => { return false } }
}
// Bytes an update of `length` can write.
fn updateRoom(x: &CipherContext, length: usize) -> usize { return length + 32 }
unsafe fn cipherUpdate(c: &mut Call, x: &mut CipherContext, input: &[u8]) -> bool {
  if !unsafe start(&mut x.*) { return unsafe failWith(&mut c.*, b"") }
  if !unsafe reserve(&mut c.*, updateRoom(&x.*, input.length)) { return false }
  let mut anchor = ()
  let out = unsafe outputSlice(&mut anchor, &c.*)
  let mut n = input.length
  let failed = match &mut x.state {
    CipherState.Ecb { v } => aesFailed(v.update(input, move out), &mut n)
    CipherState.Cbc { v } => aesFailed(v.update(input, move out), &mut n)
    CipherState.Cfb { v } => aesApplyFailed(v.apply(input, move out))
    CipherState.Cfb8 { v } => aesApplyFailed(v.apply(input, move out))
    CipherState.Cfb1 { v } => aesApplyFailed(v.apply(input, move out))
    CipherState.Ofb { v } => aesApplyFailed(v.apply(input, move out))
    CipherState.Ctr { v } => aesApplyFailed(v.apply(input, move out))
    CipherState.GcmSeal { v } => gcmFailed(v.update(input, move out))
    CipherState.GcmOpen { v } => gcmFailed(v.update(input, move out))
    CipherState.PolySeal { v } => aeadFailed(v.update(input, move out))
    CipherState.PolyOpen { v } => aeadFailed(v.update(input, move out))
    CipherState.Stream { v } => match move v.apply(input, move out) { Result<(), ChaCha20Error>.Success { .. } => false Result<(), ChaCha20Error>.Failure { .. } => true }
    _ => true
  }
  if failed { return unsafe failWith(&mut c.*, b"") }
  c.length = n
  return true
}
unsafe fn cipherFinal(c: &mut Call, x: &mut CipherContext) -> bool {
  if !unsafe start(&mut x.*) { return unsafe failWith(&mut c.*, b"") }
  if !unsafe reserve(&mut c.*, 32) { return false }
  c.length = 0
  let slot = Pointer.fromMutRef<CipherState>(&mut x.state)
  let state = unsafe Pointer.take<CipherState>(slot)
  unsafe Pointer.put<CipherState>(slot, CipherState.Done)
  let mut anchor = ()
  let out = unsafe outputSlice(&mut anchor, &c.*)
  let encrypt = x.encrypt
  match move state {
    CipherState.Ecb { v } => {
      let mut n: usize = 0
      if aesFailed(v.finish(move out), &mut n) { return unsafe failWith(&mut c.*, if encrypt { b"error:1C80006B:Provider routines::wrong final block length" } else { b"error:1C800064:Provider routines::bad decrypt" }) }
      c.length = n
    }
    CipherState.Cbc { v } => {
      let mut n: usize = 0
      if aesFailed(v.finish(move out), &mut n) { return unsafe failWith(&mut c.*, if encrypt { b"error:1C80006B:Provider routines::wrong final block length" } else { b"error:1C800064:Provider routines::bad decrypt" }) }
      c.length = n
    }
    CipherState.GcmSeal { v } => {
      let length = x.authTagLength
      if gcmFailed(v.finish(Slice.viewMut<u8>(&mut x.tag, 0, length))) { return unsafe failWith(&mut c.*, b"") }
      x.tagLength = length
    }
    CipherState.GcmOpen { v } => {
      if x.tagLength == 0 || gcmFailed(v.finish(Slice.view<u8>(&x.tag, 0, x.tagLength))) { return unsafe failWith(&mut c.*, b"") }
    }
    CipherState.PolySeal { v } => {
      let mut full: [u8; 16] = [0; 16]
      if aeadFailed(v.finish(&mut full)) { return unsafe failWith(&mut c.*, b"") }
      x.tag = full x.tagLength = 16
    }
    CipherState.PolyOpen { v } => {
      if x.tagLength != 16 || aeadFailed(v.finish(Slice.view<u8>(&x.tag, 0, 16))) { return unsafe failWith(&mut c.*, b"") }
    }
    CipherState.Done => { return unsafe failWith(&mut c.*, b"") }
    _ => ()
  }
  return true
}
unsafe fn cipherCreate(c: &mut Call, name: &[u8], key: &[u8], iv: &[u8], encrypt: bool, authTagLength: usize) -> bool {
  let info = cipherByName(name)
  if info.kind == 0 { return unsafe failWith(&mut c.*, b"error:0308010C:digital envelope routines::unsupported") }
  if i32.toUsize(info.keyLength) != key.length { return unsafe refuse(&mut c.*, b"ERR_CRYPTO_INVALID_KEYLEN: Invalid key length") }
  let p = unsafe calloc(1, Layout.of<CipherContext>().bytes)
  if Pointer.isNull<u8>(p) { return false }
  let ivCopy = if iv.length > 0 { unsafe calloc(1, iv.length) } else { nil() }
  let mut keyBytes: [u8; 32] = [0; 32]
  let mut i: usize = 0
  while i < key.length { keyBytes[i] = key[i] i = i + 1 }
  i = 0
  while i < iv.length { unsafe Pointer.put<u8>(unsafe at(ivCopy, i), iv[i]) i = i + 1 }
  unsafe Pointer.put<CipherContext>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut CipherContext>(unsafe nonnull(p)), CipherContext {
    kind: info.kind, encrypt: encrypt, padding: true, key: keyBytes, keyLength: key.length, iv: ivCopy, ivLength: iv.length,
    aad: nil(), aadLength: 0, tag: [0; 16], tagLength: 0, authTagLength: if authTagLength > 16 { 16 } else { authTagLength }, state: CipherState.Pending })
  c.created = p c.createdKind = 3 c.resultKind = 2
  return true
}
unsafe fn context<'a>(anchor: &'a mut (), p: ?*mut u8) -> &'a mut CipherContext {
  return unsafe Pointer.borrowMut<(), CipherContext>(move anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut CipherContext>(unsafe nonnull(p)))
}

/// Frees a handle the bridge created (kind 1 a hash, 2 an HMAC, 3 a cipher).
pub unsafe fn releaseContext(kind: i32, p: ?*mut u8) -> () {
  if Pointer.isNull<u8>(p) { return () }
  if kind == 1 { let owned = unsafe Pointer.take<HashContext>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HashContext>(unsafe nonnull(p))) drop owned }
  if kind == 2 { let owned = unsafe Pointer.take<HmacContext>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HmacContext>(unsafe nonnull(p))) drop owned }
  if kind == 3 {
    let owned = unsafe Pointer.take<CipherContext>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut CipherContext>(unsafe nonnull(p)))
    unsafe cleanse(owned.iv, owned.ivLength) unsafe free(owned.iv) unsafe free(owned.aad)
    drop owned
  }
  unsafe cleanse(p, 32)
  unsafe free(p)
}
unsafe fn newHash(c: &mut Call, code: i32) -> bool {
  let p = unsafe calloc(1, Layout.of<HashContext>().bytes)
  if Pointer.isNull<u8>(p) { return false }
  unsafe Pointer.put<HashContext>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HashContext>(unsafe nonnull(p)), HashContext { code: code, state: hashMake(code) })
  c.created = p c.createdKind = 1 c.resultKind = 2
  return true
}
// The lists Node shows (crypto.getHashes, getCiphers): OpenSSL's names, sorted.
const HASH_NAMES: &[u8] = b"RSA-MD5\nRSA-RIPEMD160\nRSA-SHA1\nRSA-SHA1-2\nRSA-SHA224\nRSA-SHA256\nRSA-SHA3-224\nRSA-SHA3-256\nRSA-SHA3-384\nRSA-SHA3-512\nRSA-SHA384\nRSA-SHA512\nRSA-SHA512/224\nRSA-SHA512/256\nRSA-SM3\nblake2b512\nblake2s256\nid-rsassa-pkcs1-v1_5-with-sha3-224\nid-rsassa-pkcs1-v1_5-with-sha3-256\nid-rsassa-pkcs1-v1_5-with-sha3-384\nid-rsassa-pkcs1-v1_5-with-sha3-512\nmd5\nmd5-sha1\nmd5WithRSAEncryption\nripemd\nripemd160\nripemd160WithRSA\nrmd160\nsha1\nsha1WithRSAEncryption\nsha224\nsha224WithRSAEncryption\nsha256\nsha256WithRSAEncryption\nsha3-224\nsha3-256\nsha3-384\nsha3-512\nsha384\nsha384WithRSAEncryption\nsha512\nsha512-224\nsha512-224WithRSAEncryption\nsha512-256\nsha512-256WithRSAEncryption\nsha512WithRSAEncryption\nshake128\nshake256\nsm3\nsm3WithRSAEncryption\nssl3-md5\nssl3-sha1\n"
const CIPHER_NAMES: &[u8] = b"aes-128-cbc\naes-128-cfb\naes-128-cfb1\naes-128-cfb8\naes-128-ctr\naes-128-ecb\naes-128-gcm\naes-128-ofb\naes-192-cbc\naes-192-cfb\naes-192-cfb1\naes-192-cfb8\naes-192-ctr\naes-192-ecb\naes-192-gcm\naes-192-ofb\naes-256-cbc\naes-256-cfb\naes-256-cfb1\naes-256-cfb8\naes-256-ctr\naes-256-ecb\naes-256-gcm\naes-256-ofb\naes128\naes192\naes256\nchacha20\nchacha20-poly1305\nid-aes128-gcm\nid-aes192-gcm\nid-aes256-gcm\n"
unsafe fn text(c: &mut Call, value: &[u8]) -> bool {
  c.resultKind = 3
  if !unsafe reserve(&mut c.*, value.length) { return false }
  let mut anchor = ()
  let out = unsafe outputSlice(&mut anchor, &c.*)
  let mut i: usize = 0
  while i < value.length { out[i] = value[i] i = i + 1 }
  return true
}
unsafe fn word(c: &mut Call, offset: usize, value: i32) -> () {
  let bits = i32.wrappingToU32(value)
  let mut i: usize = 0
  while i < 4 { unsafe Pointer.put<u8>(unsafe at(c.output, offset + i), u32.wrappingToU8(u32.shiftRight(bits, usize.toU32(i * 8)))) i = i + 1 }
}

/// Runs operation `c.op`; false on failure (with the error left in `c.error`).
pub unsafe fn execute(c: &mut Call) -> bool {
  let op = c.op
  let anchor = ()
  if op == 1 {
    let size = i64.toUsize(c.numbers[0])
    if !unsafe reserve(&mut c.*, size) { return false }
    if c.length > 0 {
      let mut a = ()
      let out = unsafe writable(&mut a, c.output, c.length)
      let mut random = OsRandom.make()
      run Random.fillBytes(move out) |> Effect.provideMut<Random>(&mut random)
    }
    return true
  }
  if op == 2 {
    c.resultKind = 1 c.result = 0
    if c.lengths[0] != c.lengths[1] { return false }
    let x = unsafe arg(&anchor, &c.*, 0) let y = unsafe arg(&anchor, &c.*, 1)
    let mut difference: u8 = 0
    let mut i: usize = 0
    while i < x.length { difference = difference | (x[i] ^ y[i]) i = i + 1 }
    if difference == 0 { c.result = 1 }
    return true
  }
  if op == 3 {
    let code = digestCode(unsafe arg(&anchor, &c.*, 4))
    if code == 0 || isXof(code) { return unsafe failWith(&mut c.*, b"") }
    let length = i64.toUsize(c.numbers[3])
    if !unsafe reserve(&mut c.*, length) { return false }
    let mut a = ()
    let out = unsafe writable(&mut a, c.output, c.capacity)
    let output = Slice.viewMut<u8>(move out, 0, c.length)
    return pbkdf2With(code, unsafe arg(&anchor, &c.*, 0), unsafe arg(&anchor, &c.*, 1), i64.toU32(c.numbers[2]), move output)
  }
  if op == 4 {
    let length = i64.toUsize(c.numbers[2])
    let cost = i64.toU64(c.numbers[3]) let blockSize = i64.toU32(c.numbers[4]) let parallelism = i64.toU32(c.numbers[5])
    let limit = i64.toU64(c.numbers[6])
    let memory = Scrypt.memoryLength(cost, blockSize, parallelism)
    let fits = match move memory { Option<u64>.Some { value } => limit == 0 || value <= limit Option<u64>.None => false }
    if !fits { return unsafe failWith(&mut c.*, b"error:030000AC:digital envelope routines::memory limit exceeded") }
    if !unsafe reserve(&mut c.*, length) { return false }
    let mut a = ()
    let out = unsafe writable(&mut a, c.output, c.capacity)
    let output = Slice.viewMut<u8>(move out, 0, length)
    let mut allocator = Allocator.systemAllocatorProvider()
    let derived = run Effect.result(Scrypt.derive(unsafe arg(&anchor, &c.*, 0), unsafe arg(&anchor, &c.*, 1), cost, blockSize, parallelism, move output)) |> Effect.provideMut<Allocator>(&mut allocator)
    return match move derived { Result<(), OutOfMemoryError | ScryptError>.Success { .. } => true Result<(), OutOfMemoryError | ScryptError>.Failure { .. } => unsafe failWith(&mut c.*, b"") }
  }
  if op == 5 {
    let code = digestCode(unsafe arg(&anchor, &c.*, 0))
    if code == 0 || isXof(code) { return unsafe failWith(&mut c.*, b"") }
    let length = i64.toUsize(c.numbers[4])
    if !unsafe reserve(&mut c.*, length) { return false }
    let mut a = ()
    let out = unsafe writable(&mut a, c.output, c.capacity)
    return hkdfWith(code, unsafe arg(&anchor, &c.*, 2), unsafe arg(&anchor, &c.*, 1), unsafe arg(&anchor, &c.*, 3), Slice.viewMut<u8>(move out, 0, length))
  }
  if op == 6 {
    let code = digestCode(unsafe arg(&anchor, &c.*, 0))
    if code == 0 { return unsafe failWith(&mut c.*, b"") }
    let length = if c.numbers[3] == 1 { i64.toUsize(c.numbers[2]) } else { digestSize(code) }
    if !unsafe reserve(&mut c.*, length) { return false }
    let mut state = hashMake(code)
    hashUpdate(&mut state, unsafe arg(&anchor, &c.*, 1))
    let mut a = ()
    let out = unsafe writable(&mut a, c.output, c.capacity)
    hashFinish(move state, Slice.viewMut<u8>(move out, 0, length))
    return true
  }
  if op == 8 {
    let code = digestCode(unsafe arg(&anchor, &c.*, 0))
    if code == 0 || isXof(code) { return unsafe failWith(&mut c.*, b"") }
    let length = digestSize(code)
    if !unsafe reserve(&mut c.*, length) { return false }
    let mut state = hmacMake(code, unsafe arg(&anchor, &c.*, 1))
    hmacUpdate(&mut state, unsafe arg(&anchor, &c.*, 2))
    let mut a = ()
    let out = unsafe writable(&mut a, c.output, c.capacity)
    hmacFinish(move state, Slice.viewMut<u8>(move out, 0, length))
    return true
  }
  if op == 9 {
    let code = digestCode(unsafe arg(&anchor, &c.*, 0))
    if code == 0 { return false }
    c.resultKind = 1 c.result = usize.toI64(digestSize(code))
    return true
  }
  if op == 10 {
    let code = digestCode(unsafe arg(&anchor, &c.*, 0))
    if code == 0 { return unsafe failWith(&mut c.*, b"") }
    return unsafe newHash(&mut c.*, code)
  }
  if op == 11 || op == 12 || op == 13 {
    let mut a = ()
    let h = unsafe Pointer.borrowMut<(), HashContext>(&mut a, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HashContext>(unsafe nonnull(c.handle)))
    if op == 11 { hashUpdate(&mut h.state, unsafe arg(&anchor, &c.*, 1)) c.resultKind = 4 return true }
    if op == 13 {
      let copied = hashCopy(&h.state) let code = h.code drop h
      let p = unsafe calloc(1, Layout.of<HashContext>().bytes)
      if Pointer.isNull<u8>(p) { return false }
      unsafe Pointer.put<HashContext>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HashContext>(unsafe nonnull(p)), HashContext { code: code, state: move copied })
      c.created = p c.createdKind = 1 c.resultKind = 2
      return true
    }
    // hashFinal: the state is consumed, so a copy finishes and the handle keeps its state.
    let code = h.code
    if c.numbers[1] >= 0 && !isXof(code) && i64.toUsize(c.numbers[1]) != digestSize(code) { return unsafe failWith(&mut c.*, b"error:1C80008B:Provider routines::xof is not supported") }
    let length = if c.numbers[1] >= 0 { i64.toUsize(c.numbers[1]) } else { digestSize(code) }
    let copied = hashCopy(&h.state) drop h
    if !unsafe reserve(&mut c.*, length) { return false }
    let mut b = ()
    let out = unsafe writable(&mut b, c.output, c.capacity)
    hashFinish(move copied, Slice.viewMut<u8>(move out, 0, length))
    return true
  }
  if op == 14 {
    let code = digestCode(unsafe arg(&anchor, &c.*, 0))
    if code == 0 || isXof(code) { return unsafe failWith(&mut c.*, b"") }
    let p = unsafe calloc(1, Layout.of<HmacContext>().bytes)
    if Pointer.isNull<u8>(p) { return false }
    unsafe Pointer.put<HmacContext>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HmacContext>(unsafe nonnull(p)), HmacContext { code: code, state: hmacMake(code, unsafe arg(&anchor, &c.*, 1)) })
    c.created = p c.createdKind = 2 c.resultKind = 2
    return true
  }
  if op == 15 {
    let mut a = ()
    let h = unsafe Pointer.borrowMut<(), HmacContext>(&mut a, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HmacContext>(unsafe nonnull(c.handle)))
    hmacUpdate(&mut h.state, unsafe arg(&anchor, &c.*, 1))
    c.resultKind = 4
    return true
  }
  if op == 16 {
    // HMAC_Final once: the state goes and an empty one (the same key's) is left in its place.
    let target = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut HmacContext>(unsafe nonnull(c.handle))
    let owned = unsafe Pointer.take<HmacContext>(target)
    let code = owned.code
    unsafe Pointer.put<HmacContext>(target, HmacContext { code: code, state: hmacMake(code, Slice.view<u8>(&EMPTY, 0, 0)) })
    let length = digestSize(code)
    if !unsafe reserve(&mut c.*, length) { return false }
    let mut b = ()
    let out = unsafe writable(&mut b, c.output, c.capacity)
    hmacFinish(move owned.state, Slice.viewMut<u8>(move out, 0, length))
    return true
  }
  if op == 20 {
    let name = unsafe arg(&anchor, &c.*, 0) let key = unsafe arg(&anchor, &c.*, 1) let iv = unsafe arg(&anchor, &c.*, 2)
    let encrypt = c.numbers[3] == 1 let tagLength = i64.toUsize(c.numbers[4])
    return unsafe cipherCreate(&mut c.*, name, key, iv, encrypt, tagLength)
  }
  if op >= 21 && op <= 26 {
    let mut a = ()
    let x = unsafe context(&mut a, c.handle)
    if op == 21 { let input = unsafe arg(&anchor, &c.*, 1) return unsafe cipherUpdate(&mut c.*, &mut x.*, input) }
    if op == 22 { return unsafe cipherFinal(&mut c.*, &mut x.*) }
    c.resultKind = 4
    if op == 23 {
      // Additional data: only before the first update, and only for the AEAD ciphers.
      match &x.state { CipherState.Pending => () _ => { return false } }
      if x.kind != C_GCM && x.kind != C_CHACHA_POLY { return false }
      let aad = unsafe arg(&anchor, &c.*, 1)
      let grown = unsafe realloc(x.aad, x.aadLength + aad.length + 1)
      if Pointer.isNull<u8>(grown) { return false }
      x.aad = grown
      let mut i: usize = 0
      while i < aad.length { unsafe Pointer.put<u8>(unsafe at(x.aad, x.aadLength + i), aad[i]) i = i + 1 }
      x.aadLength = x.aadLength + aad.length
      return true
    }
    if op == 24 {
      let tag = unsafe arg(&anchor, &c.*, 1)
      if x.encrypt || tag.length > 16 || tag.length == 0 { return false }
      let mut i: usize = 0
      while i < tag.length { x.tag[i] = tag[i] i = i + 1 }
      x.tagLength = tag.length
      return true
    }
    if op == 25 {
      let length = i64.toUsize(c.numbers[1])
      if !x.encrypt || length > x.tagLength { return false }
      let tag = x.tag
      drop x
      c.resultKind = 0
      if !unsafe reserve(&mut c.*, length) { return false }
      let mut i: usize = 0
      while i < length { unsafe Pointer.put<u8>(unsafe at(c.output, i), tag[i]) i = i + 1 }
      return true
    }
    // cipherPadding: only for the block modes, and before the first update.
    match &x.state { CipherState.Pending => () _ => { return false } }
    x.padding = c.numbers[1] != 0
    return true
  }
  if op == 7 {
    // cipherOnce: name, key, iv, input, encrypt, aad, tag (to open), tag length (to seal).
    let encrypt = c.numbers[4] == 1
    let name = unsafe arg(&anchor, &c.*, 0) let key = unsafe arg(&anchor, &c.*, 1) let iv = unsafe arg(&anchor, &c.*, 2)
    let sealTag = i64.toUsize(c.numbers[7])
    if !unsafe cipherCreate(&mut c.*, name, key, iv, encrypt, sealTag) { return false }
    let p = c.created c.created = nil() c.createdKind = 0 c.resultKind = 0
    let mut a = ()
    let x = unsafe context(&mut a, p)
    let info = cipherByName(unsafe arg(&anchor, &c.*, 0))
    if !encrypt && (x.kind == C_GCM || x.kind == C_CHACHA_POLY) {
      let tag = unsafe arg(&anchor, &c.*, 6)
      let mut i: usize = 0
      while i < tag.length && i < 16 { x.tag[i] = tag[i] i = i + 1 }
      x.tagLength = tag.length
    }
    let aad = unsafe arg(&anchor, &c.*, 5)
    if aad.length > 0 {
      x.aad = unsafe calloc(1, aad.length)
      let mut i: usize = 0
      while i < aad.length { unsafe Pointer.put<u8>(unsafe at(x.aad, i), aad[i]) i = i + 1 }
      x.aadLength = aad.length
    }
    let _unused = info
    let input = unsafe arg(&anchor, &c.*, 3)
    let mut ok = unsafe cipherUpdate(&mut c.*, &mut x.*, input)
    let first = c.output let firstLength = c.length
    c.output = nil() c.capacity = 0
    ok = ok && unsafe cipherFinal(&mut c.*, &mut x.*)
    let tagLength = if encrypt && (x.kind == C_GCM || x.kind == C_CHACHA_POLY) { x.tagLength } else { 0 }
    let tag = x.tag
    drop x
    if ok {
      let second = c.output let secondLength = c.length
      c.output = nil()
      if unsafe reserve(&mut c.*, firstLength + secondLength + tagLength) {
        let mut i: usize = 0
        while i < firstLength { unsafe Pointer.put<u8>(unsafe at(c.output, i), unsafe Pointer.read<u8>(unsafe at(first, i))) i = i + 1 }
        i = 0
        while i < secondLength { unsafe Pointer.put<u8>(unsafe at(c.output, firstLength + i), unsafe Pointer.read<u8>(unsafe at(second, i))) i = i + 1 }
        i = 0
        while i < tagLength { unsafe Pointer.put<u8>(unsafe at(c.output, firstLength + secondLength + i), tag[i]) i = i + 1 }
      } else { ok = false }
      unsafe free(second)
    }
    unsafe free(first)
    unsafe releaseContext(3, p)
    return ok
  }
  if op == 60 { return unsafe text(&mut c.*, HASH_NAMES) }
  if op == 61 { return unsafe text(&mut c.*, CIPHER_NAMES) }
  if op == 62 { return unsafe text(&mut c.*, b"") }
  if op == 63 || op == 79 || op == 84 || op == 71 || op == 77 || op == 72 { c.resultKind = 1 c.result = 0 return true }
  if op == 64 { c.resultKind = 4 return c.numbers[0] == 0 }
  if op == 78 { c.resultKind = 1 c.result = 1 return true }
  if op == 83 { c.resultKind = 1 c.result = 1 return true }
  if op == 82 || op == 85 { c.resultKind = 4 return true }
  // No provider algorithms (ML-KEM, ML-DSA, KMAC, Argon2) and no provider MACs.
  if op == 150 { c.resultKind = 1 c.result = 0 return true }
  if op == 144 { return unsafe text(&mut c.*, b"") }
  if op == 68 {
    c.resultKind = 4
    let info = if c.numbers[3] != 0 { cipherByNid(i64.toI32(c.numbers[0])) } else { cipherByName(unsafe arg(&anchor, &c.*, 0)) }
    if info.kind == 0 { return true }
    let mut keyLength = info.keyLength let mut ivLength = info.ivLength
    if c.numbers[4] != 0 { if i64.toI32(c.numbers[1]) != info.keyLength { return true } keyLength = i64.toI32(c.numbers[1]) }
    if c.numbers[5] != 0 {
      let wanted = i64.toI32(c.numbers[2])
      if info.kind == C_GCM { if wanted < 1 { return true } }
      else if info.kind == C_CHACHA_POLY { if wanted < 1 || wanted > 12 { return true } }
      else if wanted != info.ivLength { return true }
      ivLength = wanted
    }
    c.resultKind = 0
    if !unsafe reserve(&mut c.*, 20 + info.name.length) { return false }
    unsafe word(&mut c.*, 0, info.mode) unsafe word(&mut c.*, 4, info.nid) unsafe word(&mut c.*, 8, info.blockSize)
    unsafe word(&mut c.*, 12, keyLength) unsafe word(&mut c.*, 16, ivLength)
    let mut i: usize = 0
    while i < info.name.length { unsafe Pointer.put<u8>(unsafe at(c.output, 20 + i), info.name[i]) i = i + 1 }
    return true
  }
  return unsafe refuse(&mut c.*, b"ERR_CRYPTO_UNSUPPORTED_OPERATION: this operation is not available with SilkCrypto")
}
