          "-DWASM_DISABLE_WRITE_GS_BASE=0",
          "-DWASM_ENABLE_AOT_INTRINSICS=0",
          "-DWASM_ENABLE_BULK_MEMORY=1",
          "-DWASM_ENABLE_CUSTOM_NAME_SECTION=1",
          "-DWASM_ENABLE_EXCE_HANDLING=1",
          "-DWASM_ENABLE_EXTENDED_CONST_EXPR=1",
          "-DWASM_ENABLE_FAST_INTERP=0",
          "-DWASM_ENABLE_GC=1",
          "-DWASM_ENABLE_INTERP=1",
          "-DWASM_ENABLE_LOAD_CUSTOM_SECTION=1",
          "-DWASM_ENABLE_MEMORY64=1",
          "-DWASM_ENABLE_MINI_LOADER=0",
          "-DWASM_ENABLE_MULTI_MEMORY=1",
          "-DWASM_ENABLE_MULTI_MODULE=1",
          "-DWASM_ENABLE_QUICK_AOT_ENTRY=0",
          "-DWASM_ENABLE_REF_TYPES=1",
          "-DWASM_ENABLE_SHARED_MEMORY=1",
          "-DWASM_ENABLE_SHRUNK_MEMORY=1",
          "-DWASM_ENABLE_SIMD=1",
          "-DWASM_ENABLE_SIMDE=1",
          "-DWASM_ENABLE_TAGS=1",
          "-DWASM_ENABLE_TAIL_CALL=1",
          "-DWASM_GLOBAL_HEAP_SIZE=10485760",
          "-DBH_PLATFORM_DARWIN",
        ],
        &[
          sourcePath("vendor/wamr/core/iwasm/interpreter"),
          sourcePath("vendor/wamr/core/iwasm/common/gc"),
          Plan.archivePath("silkjs-simde", ""),
          sourcePath("vendor/wamr/core/iwasm/include"),
          sourcePath("vendor/wamr/core/shared/platform/darwin"),
          sourcePath("vendor/wamr/core/shared/platform/include"),
          sourcePath("vendor/wamr/core/shared/mem-alloc"),
          sourcePath("vendor/wamr/core/iwasm/common"),
          sourcePath("vendor/wamr/core/shared/utils"),
          sourcePath("src/ext/wamr"),
        ],
      )
  }
  if Intrinsic.targetOperatingSystem() == "linux" {
    plan = plan |> Plan.linkLibrary("pthread", Library.dynamicSearch())
  }
  if Intrinsic.targetOperatingSystem() == "linux" {
    plan = plan |> Plan.linkLibrary("dl", Library.dynamicSearch())
  }
  if Intrinsic.targetOperatingSystem() == "linux" {
    plan = plan |> Plan.linkLibrary("m", Library.dynamicSearch())
  }
  return plan
}

pub const PLAN: Plan = plan()
