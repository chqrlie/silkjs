//! The engine's tasks, run with `silk task <name>` from `modules/engine`.
//!
//! Each task runs one of the Python scripts in `scripts/` with typed options, so `silk task`
//! lists what there is to run and `silk task <name> --help` says how. The scripts still hold
//! the work; this program is their entry point.
//!
//! The `bench-` tasks run `scripts/bench_engines.py`, the comparison with other engines
//! (`bench/README.md`).

import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem }
import silk.system.host_input { HostInput, HostInputError }

union Tasks {
  Check { pub skipNative: bool, pub skipBench: bool },
  Bench {
    pub label: Option<Bytes>,
    pub compare: Option<Bytes>,
    pub runs: Option<Bytes>,
    pub reference: Option<Bytes>,
    pub skipMicro: bool,
    pub skipMacro: bool,
    pub only: List<Bytes>,
  },
  Pgo { pub pgoOutput: Option<Bytes>, pub keep: bool },
  FunctionOrder { pub binary: Option<Bytes> },
  BenchSetup { pub setupWork: Option<Bytes>, pub steps: List<Bytes> },
  BenchOctane {
    pub octaneRounds: Option<Bytes>,
    pub octaneEngine: Option<Bytes>,
    pub octaneEngines: Option<Bytes>,
    pub octaneJit: bool,
    pub octaneOut: Option<Bytes>,
    pub octaneWork: Option<Bytes>,
    pub octaneForce: bool,
    pub benchmarks: List<Bytes>,
  },
  BenchMicro {
    pub microRounds: Option<Bytes>,
    pub microEngine: Option<Bytes>,
    pub microEngines: Option<Bytes>,
    pub microJit: bool,
    pub microOut: Option<Bytes>,
    pub microWork: Option<Bytes>,
    pub microForce: bool,
    pub tests: List<Bytes>,
  },
  BenchFixed {
    pub fixedRounds: Option<Bytes>,
    pub fixedOnly: Option<Bytes>,
    pub iterations: Option<Bytes>,
    pub fixedWork: Option<Bytes>,
    pub fixedForce: bool,
    pub binaries: List<Bytes>,
  },
  BenchReport { pub nativeOnly: bool, pub jitResults: Option<Bytes>, pub reportOut: Option<Bytes>, pub reportWork: Option<Bytes> },
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "The SilkJS engine's tasks")
      |> Command.variant(
        "Check",
        "The correctness gate: entry-point type check, native suite, QuickJS and SilkJS tests, benchmark outputs (needs `silk build --release`)",
      )
      |> Command.option("skipNative", Opt.about("Skip the native regression suite"))
      |> Command.option("skipBench", Opt.about("Skip the benchmark output check"))
      |> Command.variant("Bench", "Run the performance suite and record or compare results")
      |> Command.option("label", Opt.about("Write bench/results/<label>.json"))
      |> Command.option("compare", Opt.about("Compare against a recorded results JSON; fails on a regression"))
      |> Command.option("runs", Opt.about("Runs per macro workload (default 5)"))
      |> Command.option("reference", Opt.about("Also measure this C QuickJS qjs binary"))
      |> Command.option("skipMicro", Opt.about("Skip the micro benchmark (about 15 minutes)"))
      |> Command.option("skipMacro", Opt.about("Skip the macro workloads"))
      |> Command.arg("only", Opt.about("Macro names or micro test prefixes to run"))
      |> Command.variant("Pgo", "Build the release CLI with profile-guided optimization (build/pgo/silkjs)")
      |> Command.option("pgoOutput", Opt.about("Where to write the optimized CLI") |> Opt.long("output"))
      |> Command.option("keep", Opt.about("Keep build/pgo/work: profiles and the instrumented CLI"))
      |> Command.variant("FunctionOrder", "Regenerate startup.order from a release build under callgrind")
      |> Command.arg("binary", Opt.about("The release CLI (default: this host's release build)"))
      |> Command.variant(
        "BenchSetup",
        "Install the reference engines of the comparison: Node check, jsc, Octane, QuickJS, wasmtime, wasi-sdk, the wasm builds",
      )
      |> Command.option("setupWork", Opt.about("The work directory (default: SILKJS_BENCH_WORK, else build/bench)") |> Opt.long("work"))
      |> Command.arg("steps", Opt.about("Steps to run (default all): node jsc octane quickjs wasmtime wasi-sdk wasm"))
      |> Command.variant("BenchOctane", "Run Octane under silkjs, V8 jitless, JSC without its JIT, QuickJS and the wasm builds")
      |> Command.option("octaneRounds", Opt.about("Interleaved rounds (default 3)") |> Opt.long("rounds"))
      |> Command.option("octaneEngine", Opt.about("The silkjs executable (default: SILKJS_ENGINE, else this host's release build)") |> Opt.long("engine"))
      |> Command.option("octaneEngines", Opt.about("Columns, comma-separated (default: every installed one of silkjs,v8-jitless,jsc-nojit,qjs,silkjs-wasm,qjs-wasm)") |> Opt.long("engines"))
      |> Command.option("octaneJit", Opt.about("Add the v8-jit and jsc-jit columns, for context only") |> Opt.long("jit"))
      |> Command.option("octaneOut", Opt.about("Where to write results (default: <work>/results)") |> Opt.long("out"))
      |> Command.option("octaneWork", Opt.about("The work directory of bench-setup (default: SILKJS_BENCH_WORK, else build/bench)") |> Opt.long("work"))
      |> Command.option("octaneForce", Opt.about("Measure even while a build runs or the host is busy") |> Opt.long("force"))
      |> Command.arg("benchmarks", Opt.about("Octane benchmarks to run, such as richards splay"))
      |> Command.variant("BenchMicro", "Run bench/microbench.js under the same engines")
      |> Command.option("microRounds", Opt.about("Interleaved rounds (default 3)") |> Opt.long("rounds"))
      |> Command.option("microEngine", Opt.about("The silkjs executable (default: SILKJS_ENGINE, else this host's release build)") |> Opt.long("engine"))
      |> Command.option("microEngines", Opt.about("Columns, comma-separated (default: every installed one of silkjs,v8-jitless,jsc-nojit,qjs,silkjs-wasm,qjs-wasm)") |> Opt.long("engines"))
      |> Command.option("microJit", Opt.about("Add the v8-jit and jsc-jit columns, for context only") |> Opt.long("jit"))
      |> Command.option("microOut", Opt.about("Where to write results (default: <work>/results)") |> Opt.long("out"))
      |> Command.option("microWork", Opt.about("The work directory of bench-setup (default: SILKJS_BENCH_WORK, else build/bench)") |> Opt.long("work"))
      |> Command.option("microForce", Opt.about("Measure even while a build runs or the host is busy") |> Opt.long("force"))
      |> Command.arg("tests", Opt.about("microbench.js test names to run"))
      |> Command.variant("BenchFixed", "Compare builds on fixed Octane work: minimum user time, under 2% is noise")
      |> Command.option("fixedRounds", Opt.about("Interleaved rounds (default 7)") |> Opt.long("rounds"))
      |> Command.option("fixedOnly", Opt.about("Octane benchmarks, comma-separated, such as richards,deltablue") |> Opt.long("only"))
      |> Command.option("iterations", Opt.about("Iterations of each benchmark (default: as scripts/v8bench.py)"))
      |> Command.option("fixedWork", Opt.about("The work directory of bench-setup") |> Opt.long("work"))
      |> Command.option("fixedForce", Opt.about("Measure even while a build runs or the host is busy") |> Opt.long("force"))
      |> Command.arg("binaries", Opt.about("The executables to compare: OLD NEW"))
      |> Command.variant("BenchReport", "Print the tables from the results of bench-octane and bench-micro")
      |> Command.option("nativeOnly", Opt.about("The native-only table instead of the one with the wasm columns") |> Opt.long("native"))
      |> Command.option("jitResults", Opt.about("An octane.json with v8-jit and jsc-jit columns, for the native table"))
      |> Command.option("reportOut", Opt.about("The results directory (default: <work>/results)") |> Opt.long("out"))
      |> Command.option("reportWork", Opt.about("The work directory of bench-setup") |> Opt.long("work"))
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    let mut argv = List<Bytes>.make()
    match move self {
      Tasks.Check { skipNative, skipBench } => {
        run word(&mut argv, b"scripts/check.py")
        if skipNative { run word(&mut argv, b"--skip-native") }
        if skipBench { run word(&mut argv, b"--skip-bench") }
      }
      Tasks.Bench { label, compare, runs, reference, skipMicro, skipMacro, only } => {
        run word(&mut argv, b"scripts/bench.py")
        run valued(&mut argv, b"--label", move label)
        run valued(&mut argv, b"--compare", move compare)
        run valued(&mut argv, b"--runs", move runs)
        run valued(&mut argv, b"--reference", move reference)
        if skipMicro { run word(&mut argv, b"--skip-micro") }
        if skipMacro { run word(&mut argv, b"--skip-macro") }
        if List<Bytes>.length(&only) > 0 {
          run word(&mut argv, b"--only")
          run words(&mut argv, &only)
        }
      }
      Tasks.Pgo { pgoOutput, keep } => {
        run word(&mut argv, b"scripts/pgo_build.py")
        run valued(&mut argv, b"--output", move pgoOutput)
        if keep { run word(&mut argv, b"--keep") }
      }
      Tasks.FunctionOrder { binary } => {
        run word(&mut argv, b"scripts/function_order.py")
        match move binary {
          Option<Bytes>.Some { value } => run List<Bytes>.append(&mut argv, move value)
          Option<Bytes>.None => {}
        }
      }
      Tasks.BenchSetup { setupWork, steps } => {
        run enginesTool(&mut argv, b"setup")
        run valued(&mut argv, b"--work", move setupWork)
        run words(&mut argv, &steps)
      }
      Tasks.BenchOctane { octaneRounds, octaneEngine, octaneEngines, octaneJit, octaneOut, octaneWork, octaneForce, benchmarks } => {
        run enginesTool(&mut argv, b"octane")
        run measured(&mut argv, move octaneRounds, move octaneEngine, move octaneEngines, octaneJit, move octaneOut, move octaneWork, octaneForce)
        run words(&mut argv, &benchmarks)
      }
      Tasks.BenchMicro { microRounds, microEngine, microEngines, microJit, microOut, microWork, microForce, tests } => {
        run enginesTool(&mut argv, b"micro")
        run measured(&mut argv, move microRounds, move microEngine, move microEngines, microJit, move microOut, move microWork, microForce)
        run words(&mut argv, &tests)
      }
      Tasks.BenchFixed { fixedRounds, fixedOnly, iterations, fixedWork, fixedForce, binaries } => {
        run enginesTool(&mut argv, b"fixed")
        run valued(&mut argv, b"--rounds", move fixedRounds)
        run valued(&mut argv, b"--only", move fixedOnly)
        run valued(&mut argv, b"--iterations", move iterations)
        run valued(&mut argv, b"--work", move fixedWork)
        if fixedForce { run word(&mut argv, b"--force") }
        run words(&mut argv, &binaries)
      }
      Tasks.BenchReport { nativeOnly, jitResults, reportOut, reportWork } => {
        run enginesTool(&mut argv, b"report")
        if nativeOnly { run word(&mut argv, b"--native") }
        run valued(&mut argv, b"--jit-results", move jitResults)
        run valued(&mut argv, b"--out", move reportOut)
        run valued(&mut argv, b"--work", move reportWork)
      }
    }
    run Task.execBytes(b"python3", List<Bytes>.asSlice(&argv))
  }
}

pub effect fn main() -> i32 ? &mut HostInput {
  return run Task.main<Tasks>()
}

// Appends one argument.
effect fn word(argv: &mut List<Bytes>, text: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run List<Bytes>.append(&mut argv.*, run Bytes.copy(text))
}

// Appends a copy of each argument in `values`.
effect fn words(argv: &mut List<Bytes>, values: &List<Bytes>) -> () ! OutOfMemoryError ? &mut Allocator {
  let listed = List<Bytes>.asSlice(values)
  let mut at: usize = 0
  while at < listed.length {
    run word(&mut argv.*, Bytes.asSlice(&listed[at]))
    at = at + 1
  }
}

// Starts a `scripts/bench_engines.py` command.
effect fn enginesTool(argv: &mut List<Bytes>, command: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run word(&mut argv.*, b"scripts/bench_engines.py")
  run word(&mut argv.*, command)
}

// Appends the options the measuring commands of `scripts/bench_engines.py` share.
effect fn measured(
  argv: &mut List<Bytes>,
  rounds: Option<Bytes>,
  executable: Option<Bytes>,
  columns: Option<Bytes>,
  jit: bool,
  output: Option<Bytes>,
  workDir: Option<Bytes>,
  forced: bool,
) -> () ! OutOfMemoryError ? &mut Allocator {
  run valued(&mut argv.*, b"--rounds", move rounds)
  run valued(&mut argv.*, b"--engine", move executable)
  run valued(&mut argv.*, b"--engines", move columns)
  if jit { run word(&mut argv.*, b"--jit") }
  run valued(&mut argv.*, b"--out", move output)
  run valued(&mut argv.*, b"--work", move workDir)
  if forced { run word(&mut argv.*, b"--force") }
}

// Appends `flag` and its value when the option was given.
effect fn valued(argv: &mut List<Bytes>, flag: &[u8], value: Option<Bytes>) -> () ! OutOfMemoryError ? &mut Allocator {
  match move value {
    Option<Bytes>.Some { value: given } => {
      run word(&mut argv.*, flag)
      run List<Bytes>.append(&mut argv.*, move given)
    }
    Option<Bytes>.None => {}
  }
}
