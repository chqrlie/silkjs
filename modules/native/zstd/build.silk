import silk.build.plan { Plan }
import silk.build.step { sourcePath }

static fn plan() -> Plan {
  let mut plan = Plan.empty()
  if Intrinsic.targetOperatingSystem() == "linux" || Intrinsic.targetOperatingSystem() == "darwin" {
    plan = plan
      |> Plan.compileSources(
        "c",
        Plan.archivePath("silkjs-zstd", "lib/common"),
        "*.c",
        &["-O2", "-w", "-DZSTD_MULTITHREAD", "-DZSTD_DISABLE_ASM", "-DXXH_NAMESPACE=ZSTD_"],
        &[Plan.archivePath("silkjs-zstd", "lib"), Plan.archivePath("silkjs-zstd", "lib/common")],
      )
    plan = plan
      |> Plan.compileSources(
        "c",
        Plan.archivePath("silkjs-zstd", "lib/compress"),
        "*.c",
        &["-O2", "-w", "-DZSTD_MULTITHREAD", "-DZSTD_DISABLE_ASM", "-DXXH_NAMESPACE=ZSTD_"],
        &[Plan.archivePath("silkjs-zstd", "lib"), Plan.archivePath("silkjs-zstd", "lib/common")],
      )
    plan = plan
      |> Plan.compileSources(
        "c",
        Plan.archivePath("silkjs-zstd", "lib/decompress"),
        "*.c",
        &["-O2", "-w", "-DZSTD_MULTITHREAD", "-DZSTD_DISABLE_ASM", "-DXXH_NAMESPACE=ZSTD_"],
        &[Plan.archivePath("silkjs-zstd", "lib"), Plan.archivePath("silkjs-zstd", "lib/common")],
      )
  }
  return plan
}

pub const PLAN: Plan = plan()
